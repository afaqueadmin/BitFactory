model Hardware {
  id                 String                       @id @default(cuid())
  model              String                       @unique
  powerUsage         Float
  hashRate           Decimal
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  quantity           Int                          @default(1)
  isDeleted          Boolean                      @default(false)
  createdById        String?
  updatedById        String?
  deletedById        String?
  deletedAt          DateTime?
  createdBy          User?                        @relation("HardwareCreatedBy", fields: [createdById], references: [id])
  updatedBy          User?                        @relation("HardwareUpdatedBy", fields: [updatedById], references: [id])
  deletedBy          User?                        @relation("HardwareDeletedBy", fields: [deletedById], references: [id])
  procurementHistory HardwareProcurementHistory[]
  miners             Miner[]
  invoices           Invoice[]
  invoiceLineItems   InvoiceLineItem[]

  @@index([isDeleted])
  @@map("hardware")
}

model Miner {
  id                     String                   @id @default(cuid())
  name                   String
  status                 String                   @default("DEPLOYMENT_IN_PROGRESS")
  userId                 String
  spaceId                String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  hardwareId             String
  isDeleted              Boolean                  @default(false)
  poolId                 String?
  poolAuth               String?
  serialNumber           String?
  macAddress             String?
  // Manufacturer warranty end date, entered by an admin (not derivable:
  // miners aren't linked to purchase invoices). Null = not recorded.
  warrantyExpiresAt      DateTime?                @db.Date
  createdById            String?
  updatedById            String?
  deletedById            String?
  deletedAt              DateTime?
  createdBy              User?                    @relation("MinerCreatedBy", fields: [createdById], references: [id])
  updatedBy              User?                    @relation("MinerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy              User?                    @relation("MinerDeletedBy", fields: [deletedById], references: [id])
  ownershipHistory       MinerOwnershipHistory[]
  rateHistory            MinerRateHistory[]
  poolHistory            MinerPoolHistory[]
  hashrateBenchmarks     MinerHashrateBenchmark[]
  hashrateAlertLogs      MinerHashrateAlertLog[]
  restarts               MinerRestart[]
  hardware               Hardware                 @relation(fields: [hardwareId], references: [id])
  space                  Space                    @relation(fields: [spaceId], references: [id])
  user                   User                     @relation(fields: [userId], references: [id])
  pool                   Pool?                    @relation(fields: [poolId], references: [id])
  repairNotes            MinerRepairNote[]        @relation("MinerRepairNotes")
  repairInvoices         Invoice[]                @relation("minerRepairInvoices")
  tickets                SupportTicket[]
  firmwareChangeRequests FirmwareChangeRequest[]
  simulationSettings     SimulationSettings[]

