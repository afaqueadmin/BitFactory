  @@index([hardwareId])
  @@index([isDeleted])
  @@index([poolId])
  @@map("miners")
}

model MinerRateHistory {
  id           String   @id @default(cuid())
  minerId      String
  rate_per_kwh Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())
  createdById  String?
  miner        Miner    @relation(fields: [minerId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation("MinerRateHistoryCreatedBy", fields: [createdById], references: [id])

  @@index([minerId])
  @@index([minerId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("miner_rate_history")
}

model Space {
  id            String   @id @default(cuid())
  name          String
  location      String
  address       String?
  capacity      Int
  powerCapacity Float
  status        String   @default("AVAILABLE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  miners        Miner[]

  @@map("spaces")
}

model Pool {
  id          String   @id @default(cuid())
  name        String   @unique
  apiUrl      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  miners          Miner[]
  poolAuths       PoolAuth[]
  poolHistory     MinerPoolHistory[]
  poolSubaccounts PoolSubaccount[]
  transactions    PoolTransaction[]

  @@map("pools")
}

model PoolAuth {
  id        String   @id @default(cuid())
  poolId    String
  userId    String
  authKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pool             Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSubaccounts GroupSubaccount[]
  poolSubaccounts  PoolSubaccount[]
  guild            Guild?

  // One subaccount/token belongs to exactly one user per pool. A user can
  // still hold several rows per pool (multiple Luxor subaccounts).
  @@unique([poolId, authKey])
  @@index([userId])
  @@index([poolId])
  @@map("pool_auths")
}

// ============================================================================
// Pool historical data (Luxor / Braiins) — captured on our own cadence so we
// stop depending on the pools' retention and reduce live API calls.
//
// PoolSubaccount is the dimension row: one per (pool, subaccountName). userId
// is nullable because not every subaccount is tied to a client yet —
// GroupSubaccount rows can be credential-based with no user, and some
// subaccounts (e.g. a company-wide one used for pool-wide hashprice) are
// never linked to a User at all.
//
// PoolSubaccountDailySnapshot / PoolWorkerDailyMetric are daily rollups, not
// raw pool ticks (5m/1h) — matches the existing PaybackDailySnapshot pattern.
// PoolTransaction is the raw ledger, kept separately since it's a different
// shape/cadence (one row per pool-side transaction, not per day).
// ============================================================================

model PoolSubaccount {
  id               String    @id @default(cuid())
  poolId           String
  subaccountName   String
  userId           String?
  poolAuthId       String?
  currency         String    @default("BTC")
  walletAddress    String?
  paymentFrequency String?
  dayOfWeek        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pool           Pool                          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user           User?                         @relation(fields: [userId], references: [id])
  poolAuth       PoolAuth?                     @relation(fields: [poolAuthId], references: [id])
  dailySnapshots PoolSubaccountDailySnapshot[]
  workerMetrics  PoolWorkerDailyMetric[]
  transactions   PoolTransaction[]

  @@unique([poolId, subaccountName])
  @@index([userId])
  @@index([poolAuthId])
  @@map("pool_subaccounts")
}

model PoolSubaccountDailySnapshot {
  id               String   @id @default(cuid())
  poolSubaccountId String
  date             DateTime @db.Date

  hashrate      Decimal? // H/s, 24h average
  efficiency    Decimal? // percent 0-100; null if the pool doesn't report it (Braiins)
  uptime        Decimal? // percent 0-100; null if the pool doesn't report it (Braiins)
  activeWorkers Int?
  hashprice     Decimal?
  balance       Decimal? @db.Decimal(20, 8)

  miningRevenue   Decimal @default(0) @db.Decimal(20, 8)
  referralRevenue Decimal @default(0) @db.Decimal(20, 8)
  otherRevenue    Decimal @default(0) @db.Decimal(20, 8)
  totalRevenue    Decimal @default(0) @db.Decimal(20, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poolSubaccount PoolSubaccount @relation(fields: [poolSubaccountId], references: [id], onDelete: Cascade)

  @@unique([poolSubaccountId, date])
  @@index([date])
  @@map("pool_subaccount_daily_snapshots")
}

model PoolWorkerDailyMetric {
  id               String   @id @default(cuid())
  poolSubaccountId String
  // Identity key. Braiins workers have no stable ID, only a name, so a
  // rename reads as a new worker here — a known limitation of the source
  // data, not something we can resolve on our side.
  workerName       String
  externalWorkerId String? // Luxor's worker id, when available
  date             DateTime @db.Date

  hashrate       Decimal?
  efficiency     Decimal?
  // Luxor's GET /pool/workers reports these as fractions (e.g. 0.0102), not
  // whole counts, so they must not be Int.
  staleShares    Decimal?
  rejectedShares Decimal?
  estRevenue     Decimal? @db.Decimal(20, 8)
  firmware       String?
  status         String? // normalized ACTIVE/INACTIVE

  createdAt DateTime @default(now())

  poolSubaccount PoolSubaccount @relation(fields: [poolSubaccountId], references: [id], onDelete: Cascade)

  @@unique([poolSubaccountId, workerName, date])
  @@index([date])
  @@map("pool_worker_daily_metrics")
}

model PoolTransaction {
  id                    String   @id @default(cuid())
  // externalTransactionId is nullable and NOT the dedupe key: Luxor leaves it
  // blank ("") on ~90% of rows (daily "Miner Revenue"/"LuxOS Rebate" accrual
  // credits) and only populates it for real on-chain movements (Payment,
  // Transaction Fee). Dedup instead on the composite key below.
  poolId                String
  poolSubaccountId      String
  externalTransactionId String?
  transactionType       String // credit / debit
  category              String? // Luxor transaction_category / Braiins payout kind
  amount                Decimal  @db.Decimal(20, 8)
  usdEquivalent         Decimal? @db.Decimal(20, 2)
  addressName           String?
  status                String? // Braiins payout status: queued/confirmed/failed
  occurredAt            DateTime

  createdAt DateTime @default(now())

  pool              Pool               @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolSubaccount    PoolSubaccount     @relation(fields: [poolSubaccountId], references: [id], onDelete: Cascade)
  guildDistribution GuildDistribution?

  @@unique([poolSubaccountId, occurredAt, category, transactionType, amount])
  @@index([poolId])
  @@index([externalTransactionId])
  @@index([occurredAt])
  @@map("pool_transactions")
}

/// Admin-managed settings for every simulated account. One row (id = 1).
model SimulationSettings {
  id              Int      @id @default(1)
  /// The real company miner every simulated account mirrors.
  sourceMinerId   String
  /// What the mirrored miner is shown as (its real name can identify its owner).
  displayName     String   @default("Simulated Miner")
  /// Welcome bonus written to a new simulated account's ledger.
  welcomeBonusUsd Decimal  @db.Decimal(12, 2)
  /// Electricity rate for simulated charges - separate from the real miner's.
  ratePerKwh      Decimal  @db.Decimal(10, 6)
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceMiner Miner @relation(fields: [sourceMinerId], references: [id], onDelete: Restrict)
  updatedBy   User? @relation("simulationSettingsUpdated", fields: [updatedById], references: [id])

  @@map("simulation_settings")
}

/// A simulated account's cost ledger: welcome bonus, daily electricity
/// charges (cron_simulated_daily_cost) and admin payments/adjustments.
/// Same shape as CostPayment but kept apart so simulated money never reaches
/// real accounting.
model SimulatedCostPayment {
  id          String      @id @default(cuid())
  userId      String
  /// USD; negative for a charge.
  amount      Float
  /// kWh.
  consumption Float       @default(0)
  type        PaymentType
  narration   String?
  /// The UTC day an ELECTRICITY_CHARGES row is for; null on other types.
  /// Unique per user so the cron never charges a day twice.
  chargeDate  DateTime?   @db.Date
  createdAt   DateTime    @default(now())
  createdById String?
  isDeleted   Boolean     @default(false)

  user      User  @relation("simulatedCostPayments", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("simulatedCostPaymentsCreated", fields: [createdById], references: [id])

  @@unique([userId, chargeDate])
  @@index([userId])
  @@index([createdAt])
  @@map("simulated_cost_payments")
}

// One "you've been paid" wallet snapshot email per customer per payout day,
// written by cron_wallet_payment_email. Several subaccounts paid on the same
// day share one row (and one email); FAILED rows are retried until
// attempts reaches the cron's limit.
model WalletPaymentEmail {
  id         String    @id @default(cuid())
  userId     String
  /// The UTC day of the payout.
  payoutDate DateTime  @db.Date
  /// "luxor" | "simulated"
  source     String
  /// Sum of the day's Payment debits, BTC.
  payoutBtc  Decimal   @db.Decimal(20, 8)
  /// "SENT" | "FAILED"
  status     String
  attempts   Int       @default(0)
  lastError  String?
  sentTo     String?
  ccEmails   String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payoutDate])
  @@index([payoutDate])
  @@map("wallet_payment_emails")
}

model CostPayment {
  id             String              @id @default(cuid())
  userId         String
  invoiceId      String?
  memoId         String?
  amount         Float
  consumption    Float
  type           PaymentType
  createdAt      DateTime            @default(now())
  narration      String?
  isDeleted      Boolean             @default(false)
  // Receiving account and currency, set by the admin record-payment route
  // (Hosting & Colocation, Hardware Sales). Null on older rows and on
  // payments created elsewhere (Confirmo, memos, franchise, cron).
  // originalAmount is in the payment currency; amount stays USD
  // (originalAmount / exchangeRate, where 1 USD = exchangeRate currency).
  entityId       String?
  bankId         String?
  currencyId     String?
  originalAmount Decimal?            @db.Decimal(18, 2)
  exchangeRate   Decimal?            @db.Decimal(18, 8)
  // Date the payment was received (D11); createdAt is when it was recorded.
  paymentDate    DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice        Invoice?            @relation("invoiceCostPayments", fields: [invoiceId], references: [id], onDelete: Cascade)
  memo           Memo?               @relation(fields: [memoId], references: [id])
  entity         AccountingEntity?   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  bank           AccountingBank?     @relation(fields: [bankId], references: [id], onDelete: Restrict)
  currency       AccountingCurrency? @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([invoiceId])
  @@index([memoId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([entityId])
  @@index([bankId])
  @@index([currencyId])
  @@map("cost_payments")
}

model MinerOwnershipHistory {
  id          String   @id @default(cuid())
  ownerId     String
  createdById String
  createdAt   DateTime @default(now())
  minerId     String?
  createdBy   User     @relation("createdBy", fields: [createdById], references: [id], onDelete: Cascade)
  miner       Miner?   @relation(fields: [minerId], references: [id], onDelete: Cascade)
  owner       User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([ownerId])
  @@index([createdById])
  @@map("miner_ownership_history")
}

model MinerPoolHistory {
  id          String   @id @default(cuid())
  minerId     String
  poolId      String
  createdById String
  createdAt   DateTime @default(now())

  miner     Miner @relation(fields: [minerId], references: [id], onDelete: Cascade)
  pool      Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  createdBy User  @relation("MinerPoolHistoryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([poolId])
  @@index([createdById])
  @@map("miner_pool_history")
}

// ============================================================================
// Miner hashrate benchmark alerting.
//
// MinerHashrateBenchmark is a history table (mirrors MinerRateHistory): the
// latest row per miner (by createdAt) is the active benchmark, in TH/s to
// match Hardware.hashRate and the rest of the admin UI's convention — the
// pool tables (PoolWorkerDailyMetric.hashrate) are in H/s and must be
// converted before comparing.
//
// MinerHashrateAlertLog records which (miner, date) pairs have already been
// notified, so the alert cron (which re-scans a rolling window each run,
// since it does not run inside cron_pool_worker_transactions and can't rely
// on "just wrote this row") never sends a duplicate email for the same day.
// ============================================================================

model MinerHashrateBenchmark {
  id                String   @id @default(cuid())
  minerId           String
  benchmarkHashrate Decimal  @db.Decimal(10, 2) // TH/s
  createdAt         DateTime @default(now())
  createdById       String

  miner     Miner @relation(fields: [minerId], references: [id], onDelete: Cascade)
  createdBy User  @relation("MinerHashrateBenchmarkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([minerId, createdAt(sort: Desc)])
  @@map("miner_hashrate_benchmarks")
}

model MinerHashrateAlertLog {
  id                String    @id @default(cuid())
  minerId           String
  date              DateTime  @db.Date
  actualHashrate    Decimal   @db.Decimal(10, 2) // TH/s, converted from PoolWorkerDailyMetric.hashrate (H/s)
  benchmarkHashrate Decimal   @db.Decimal(10, 2) // TH/s, the benchmark that was in effect when this alert fired
  notifiedAt        DateTime  @default(now())
  acknowledgedAt    DateTime?
  acknowledgedById  String?

  miner          Miner          @relation(fields: [minerId], references: [id], onDelete: Cascade)
  acknowledgedBy User?          @relation("MinerHashrateAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  restarts       MinerRestart[]

  @@unique([minerId, date])
  @@index([minerId])
  @@index([acknowledgedAt])
  @@map("miner_hashrate_alert_logs")
}

// A restart an admin performed on the miner from the Luxor backend (outside
// this app) and recorded here - nothing is sent to Luxor. Append-only history,
// like MinerRateHistory. restartedAt is the admin-entered time of the restart
// itself; createdAt is when it was recorded. alertId is set when it was
// recorded from a hashrate alert row, to show which alert it responded to.
model MinerRestart {
  id          String   @id @default(cuid())
  minerId     String
  alertId     String?
  restartedAt DateTime
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  miner     Miner                  @relation(fields: [minerId], references: [id], onDelete: Cascade)
  alert     MinerHashrateAlertLog? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  createdBy User                   @relation("MinerRestartCreatedBy", fields: [createdById], references: [id])

  @@index([minerId, restartedAt(sort: Desc)])
  @@index([alertId])
  @@index([createdById])
  @@map("miner_restarts")
}

model HardwareProcurementHistory {
  id          String   @id @default(cuid())
  hardwareId  String
  quantity    Int
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  hardware    Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@index([hardwareId])
  @@index([createdById])
  @@map("hardware_procurement_history")
}

model Group {
  id                  String            @id @default(cuid())
  name                String            @db.VarChar(255)
  relationshipManager String?           @db.VarChar(255)
  email               String?           @db.VarChar(255)
  description         String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String
  subaccounts         GroupSubaccount[]
  creator             User              @relation(fields: [createdBy], references: [id])

  @@index([isActive])
  @@map("groups")
}

model GroupSubaccount {
  id             String    @id @default(cuid())
  groupId        String
  // Null for members added without a Luxor subaccount (userId-based
  // membership) - still @unique since Postgres treats multiple NULLs as
  // distinct, so this doesn't collide across those rows.
  subaccountName String?   @unique
  poolAuthId     String?
  // Direct membership for CLIENT users with no Luxor subaccount/PoolAuth.
  // Mutually exclusive with poolAuthId in practice: a row is either
  // credential-based (poolAuthId set) or user-based (userId set).
  userId         String?
  addedAt        DateTime  @default(now())
  addedBy        String
  addedByUserId  String?
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  poolAuth       PoolAuth? @relation(fields: [poolAuthId], references: [id])
  user           User?     @relation("GroupSubaccountUser", fields: [userId], references: [id])
  addedByUser    User?     @relation("GroupSubaccountAddedBy", fields: [addedByUserId], references: [id])

  @@index([groupId])
  @@index([subaccountName])
  @@index([poolAuthId])
  @@index([userId])
  @@map("group_subaccounts")
}

model Invoice {
  id                       String                @id @default(cuid())
  invoiceNumber            String                @unique
  userId                   String
  hardwareId               String?
  totalMiners              Int
  unitPrice                Decimal               @db.Decimal(10, 2)
  totalAmount              Decimal               @db.Decimal(12, 2)
  status                   InvoiceStatus
  invoiceType              InvoiceType           @default(ELECTRICITY_CHARGES)
  invoiceGeneratedDate     DateTime
  issuedDate               DateTime?
  dueDate                  DateTime
  billingMonth             DateTime? // Format: First day of month (e.g., 2026-04-01 for April 2026)
  machineHostingLocation   String[]              @default([])
  paidDate                 DateTime?
  createdBy                String
  updatedBy                String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  btcpayInvoiceId          String?               @unique
  btcpayStatus             BtcpayStatus?
  btcpayCheckoutUrl        String?
  btcpayCreatedAt          DateTime?
  btcpaySettledAt          DateTime?
  // Binance USDT payment: the deposit id / Pay transactionId that paid this
  // invoice (unique, so one transfer can't pay two invoices), and when the
  // customer opened the pay modal (only transfers after it can match).
  binanceTxId              String?               @unique
  binanceCheckoutStartedAt DateTime?
  // HARDWARE_REPAIR invoices: the one miner being repaired, and a flat
  // discount taken off the line-item subtotal (totalAmount is after it).
  // Other invoice types leave minerId null and discountAmount 0.
  minerId                  String?
  discountAmount           Decimal               @default(0) @db.Decimal(12, 2)
  miner                    Miner?                @relation("minerRepairInvoices", fields: [minerId], references: [id], onDelete: SetNull)
  repairNote               MinerRepairNote?      @relation("invoiceRepairNote")
  notifications            InvoiceNotification[] @relation("invoiceNotifications")
  costPayments             CostPayment[]         @relation("invoiceCostPayments")
  tickets                  SupportTicket[]
  confirmoPayment          ConfirmoPayment?
  emailSendResults         EmailSendResult[]     @relation("emailSendResults")
  lineItems                InvoiceLineItem[]
  memos                    Memo[]                @relation("invoiceMemos")
  createdByUser            User                  @relation("invoicesCreated", fields: [createdBy], references: [id])
  updatedByUser            User?                 @relation("invoicesUpdated", fields: [updatedBy], references: [id])
  user                     User                  @relation("invoices", fields: [userId], references: [id])
  hardware                 Hardware?             @relation(fields: [hardwareId], references: [id])
  incentiveEntries         IncentiveEntry[]      @relation("invoiceIncentiveEntries")

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@index([btcpayInvoiceId])
  @@index([minerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id               String              @id @default(cuid())
  invoiceId        String
  hardwareId       String?
  model            String
  quantity         Int
  unitPrice        Decimal             @db.Decimal(10, 2)
  totalPrice       Decimal             @db.Decimal(12, 2)
  lineItemType     InvoiceLineItemType @default(HARDWARE)
  // Month a HOSTING_COLOCATION row bills for (first day of month, UTC).
  // Null on HARDWARE rows and on hosting rows created before months existed.
  billingMonth     DateTime?
  // DISCOUNT rows: the row this discount sits under and comes off. A
  // discount's unitPrice/totalPrice are stored negative, so summing
  // totalPrice gives the net total.
  parentLineItemId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hardware  Hardware?         @relation(fields: [hardwareId], references: [id])
  parent    InvoiceLineItem?  @relation("LineItemDiscounts", fields: [parentLineItemId], references: [id], onDelete: Cascade)
  discounts InvoiceLineItem[] @relation("LineItemDiscounts")

  @@index([invoiceId])
  @@index([hardwareId])
  @@index([parentLineItemId])
  @@map("invoice_line_items")
}

model Memo {
  id           String       @id @default(cuid())
  memoNumber   String       @unique
  userId       String
  invoiceId    String?
  category     MemoCategory
  memoType     MemoType
  amount       Decimal      @db.Decimal(12, 2)
  reason       String
  status       MemoStatus   @default(ISSUED)
  issuedDate   DateTime     @default(now())
  createdBy    String
  voidedBy     String?
  voidedAt     DateTime?
  voidReason   String?
  pairedMemoId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user             User              @relation("memos", fields: [userId], references: [id])
  invoice          Invoice?          @relation("invoiceMemos", fields: [invoiceId], references: [id])
  createdByUser    User              @relation("memosCreated", fields: [createdBy], references: [id])
  voidedByUser     User?             @relation("memosVoided", fields: [voidedBy], references: [id])
  pairedMemo       Memo?             @relation("MemoPair", fields: [pairedMemoId], references: [id])
  pairedMemos      Memo[]            @relation("MemoPair")
  costPayments     CostPayment[]
  emailSendResults EmailSendResult[] @relation("emailSendResults")

  @@index([userId])
  @@index([invoiceId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([pairedMemoId])
  @@map("memos")
}

model VendorInvoice {
  id                   String                  @id @default(cuid())
  invoiceNumber        String                  @unique
  billingDate          DateTime                @db.Date
  paidDate             DateTime?
  dueDate              DateTime
  totalMiners          Int
  unitPrice            Decimal                 @db.Decimal(10, 2)
  miscellaneousCharges Decimal                 @default(0.00) @db.Decimal(10, 2)
  totalAmount          Decimal                 @db.Decimal(12, 2)
  paymentStatus        VendorPaymentStatus     @default(Pending)
  notes                String?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  // R2 object key of the vendor's invoice PDF. Null on invoices recorded
  // before PDF uploads existed.
  invoicePdfKey        String?
  // Original filename of the uploaded PDF, for display and downloads.
  invoicePdfName       String?
  // Optional Excel/CSV sheet the vendor sent with the invoice (R2 key
  // under the purpose's *-sheets/ prefix) and its original filename.
  invoiceSheetKey      String?
  invoiceSheetName     String?
  // DEPRECATED (2026-10-20): the single-currency payment columns below
  // (paymentEntityId .. transactionFee) are no longer written or read. A
  // payment is now one or more VendorPaymentPart rows (paymentParts), and
  // migration 20261020130000_vendor_payment_parts backfilled every payment
  // recorded in them into one part. Only paymentReceiptKey is still live.
  // TODO: drop these 7 columns (with their indexes, FKs and the
  // back-relations on AccountingEntity/Bank/Currency) after 2026-11-19
  // (30 days) if nothing breaks.
  // Old meaning: paymentAmount and transactionFee in the payment currency;
  // paymentExchangeRate is 1 USD = X currency.
  paymentEntityId      String?
  paymentBankId        String?
  paymentCurrencyId    String?
  paymentAmount        Decimal?                @db.Decimal(18, 2)
  paymentExchangeRate  Decimal?                @db.Decimal(18, 8)
  paymentAmountUsd     Decimal?                @db.Decimal(12, 2)
  transactionFee       Decimal?                @db.Decimal(18, 2)
  // Receipt PDF covering every part of the payment.
  paymentReceiptKey    String?
  paymentParts         VendorPaymentPart[]
  // Optional: Farm Tariffs recorded before vendors existed have none.
  vendorId             String?
  vendor               AccountingVendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // Security deposit the vendor applied to this invoice (lowers cash due).
  depositAdjustments   VendorDepositMovement[]
  createdByUser        User                    @relation("vendorInvoicesCreated", fields: [createdBy], references: [id])
  updatedByUser        User?                   @relation("vendorInvoicesUpdated", fields: [updatedBy], references: [id])
  paymentEntity        AccountingEntity?       @relation("vendorInvoicePaymentEntity", fields: [paymentEntityId], references: [id], onDelete: Restrict)
  paymentBank          AccountingBank?         @relation("vendorInvoicePaymentBank", fields: [paymentBankId], references: [id], onDelete: Restrict)
  paymentCurrency      AccountingCurrency?     @relation("vendorInvoicePaymentCurrency", fields: [paymentCurrencyId], references: [id], onDelete: Restrict)

  @@index([paymentStatus])
  @@index([billingDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([paymentEntityId])
  @@index([paymentBankId])
  @@index([paymentCurrencyId])
  @@index([vendorId])
  @@map("vendor_invoices")
}

model HardwarePurchaseInvoice {
  id                   String                  @id @default(cuid())
  invoiceNumber        String                  @unique
  vendorId             String
  // DEPRECATED (2026-10-22): replaced by vendorId (accounting_vendors). No
  // longer written or read. TODO: drop this column and the VendorName enum
  // after 2026-11-21 if nothing breaks.
  vendorName           VendorName?
  hardwareDescription  String
  billingDate          DateTime                @db.Date
  paidDate             DateTime?
  dueDate              DateTime
  quantity             Int
  unitPrice            Decimal                 @db.Decimal(10, 2)
  miscellaneousCharges Decimal                 @default(0.00) @db.Decimal(10, 2)
  // Refundable deposit the vendor holds. Part of totalAmount (so the
  // payment covers it) but not a hardware cost: cost = totalAmount -
  // securityDeposit = quantity * unitPrice + miscellaneousCharges.
  securityDeposit      Decimal                 @default(0.00) @db.Decimal(10, 2)
  totalAmount          Decimal                 @db.Decimal(12, 2)
  paymentStatus        VendorPaymentStatus     @default(Pending)
  notes                String?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  // Same PDF and payment columns as VendorInvoice; set by
  // POST /api/hardware-purchases/[id]/record-payment.
  invoicePdfKey        String?
  // Original filename of the uploaded PDF, for display and downloads.
  invoicePdfName       String?
  // Optional Excel/CSV sheet the vendor sent with the invoice (R2 key
  // under the purpose's *-sheets/ prefix) and its original filename.
  invoiceSheetKey      String?
  invoiceSheetName     String?
  // DEPRECATED (2026-10-20): same as on VendorInvoice - paymentEntityId ..
  // transactionFee are no longer written or read; the payment lives in
  // paymentParts (backfilled by 20261020130000_vendor_payment_parts).
  // TODO: drop these 7 columns after 2026-11-19 (30 days) if nothing breaks.
  paymentEntityId      String?
  paymentBankId        String?
  paymentCurrencyId    String?
  paymentAmount        Decimal?                @db.Decimal(18, 2)
  paymentExchangeRate  Decimal?                @db.Decimal(18, 8)
  paymentAmountUsd     Decimal?                @db.Decimal(12, 2)
  transactionFee       Decimal?                @db.Decimal(18, 2)
  // Receipt PDF covering every part of the payment.
  paymentReceiptKey    String?
  paymentParts         VendorPaymentPart[]
  vendor               AccountingVendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // Security deposit the vendor applied to this invoice (lowers cash due).
  depositAdjustments   VendorDepositMovement[]
  createdByUser        User                    @relation("hardwarePurchasesCreated", fields: [createdBy], references: [id])
  updatedByUser        User?                   @relation("hardwarePurchasesUpdated", fields: [updatedBy], references: [id])
  paymentEntity        AccountingEntity?       @relation("hardwarePurchasePaymentEntity", fields: [paymentEntityId], references: [id], onDelete: Restrict)
  paymentBank          AccountingBank?         @relation("hardwarePurchasePaymentBank", fields: [paymentBankId], references: [id], onDelete: Restrict)
  paymentCurrency      AccountingCurrency?     @relation("hardwarePurchasePaymentCurrency", fields: [paymentCurrencyId], references: [id], onDelete: Restrict)

  @@index([paymentStatus])
  @@index([billingDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([paymentEntityId])
  @@index([paymentBankId])
  @@index([paymentCurrencyId])
  @@index([vendorId])
  @@map("hardware_purchase_invoices")
}

/// A vendor of Hardware Purchases and/or Farm Tariffs (Finance Settings ->
/// Vendors). The two flags pick which invoice forms list it.
model AccountingVendor {
  id                   String                    @id @default(cuid())
  name                 String                    @unique
  isActive             Boolean                   @default(true)
  forHardwarePurchases Boolean                   @default(false)
  forFarmTariffs       Boolean                   @default(false)
  createdBy            String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  createdByUser        User                      @relation("accountingVendorsCreated", fields: [createdBy], references: [id])
  hardwarePurchases    HardwarePurchaseInvoice[]
  vendorInvoices       VendorInvoice[]
  depositMovements     VendorDepositMovement[]

  @@index([createdBy])
  @@map("accounting_vendors")
}

/// Security deposit leaving a vendor: a RETURN (cash paid back to us, with
/// one receiving account like a payment part) or an ADJUSTMENT (the vendor
/// applied it to one Pending Farm Tariff / Hardware Purchase invoice of the
/// same vendor, lowering that invoice's cash due). CHECK constraints in the
/// migration enforce the per-type columns.
model VendorDepositMovement {
  id                 String                    @id @default(cuid())
  vendorId           String
  type               VendorDepositMovementType
  date               DateTime                  @db.Date
  amountUsd          Decimal                   @db.Decimal(12, 2)
  note               String?
  // RETURN only. amount and transactionFee are in the currency;
  // 1 USD = exchangeRate currency.
  entityId           String?
  bankId             String?
  currencyId         String?
  amount             Decimal?                  @db.Decimal(18, 2)
  exchangeRate       Decimal?                  @db.Decimal(18, 8)
  transactionFee     Decimal?                  @db.Decimal(18, 2)
  receiptKey         String?
  // ADJUSTMENT only: exactly one of these.
  vendorInvoiceId    String?
  hardwarePurchaseId String?
  createdBy          String
  createdAt          DateTime                  @default(now())

  vendor           AccountingVendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  entity           AccountingEntity?        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  bank             AccountingBank?          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  currency         AccountingCurrency?      @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  vendorInvoice    VendorInvoice?           @relation(fields: [vendorInvoiceId], references: [id], onDelete: Restrict)
  hardwarePurchase HardwarePurchaseInvoice? @relation(fields: [hardwarePurchaseId], references: [id], onDelete: Restrict)
  createdByUser    User                     @relation("vendorDepositMovementsCreated", fields: [createdBy], references: [id])

  @@index([vendorId])
  @@index([vendorInvoiceId])
  @@index([hardwarePurchaseId])
  @@index([entityId])
  @@index([bankId])
  @@index([currencyId])
  @@map("vendor_deposit_movements")
}

enum VendorDepositMovementType {
  RETURN
  ADJUSTMENT
}

/// One currency part of a Farm Tariff (VendorInvoice) or Hardware Purchase
/// payment. A payment can be split across currencies, each with its own
/// entity, bank, rate and fee, e.g. 5 USD + 10 AED at 2 for a 10 USD
/// invoice; together the parts' USD values must match the invoice total
/// (D8). Exactly one of vendorInvoiceId / hardwarePurchaseId is set (CHECK
/// constraint in the migration). Payments recorded before multi-currency
/// were backfilled into one part each (sortOrder 0) from the invoice's
/// deprecated payment columns.
model VendorPaymentPart {
  id                 String   @id @default(cuid())
  vendorInvoiceId    String?
  hardwarePurchaseId String?
  entityId           String
  bankId             String
  currencyId         String
  /// In the part's currency. Includes transactionFee (payments recorded
  /// before 2026-10-30 didn't).
  amount             Decimal  @db.Decimal(18, 2)
  /// 1 USD = exchangeRate currency.
  exchangeRate       Decimal  @db.Decimal(18, 8)
  /// amount / exchangeRate, rounded to cents.
  amountUsd          Decimal  @db.Decimal(12, 2)
  /// In the part's currency. D8: the parts' amounts must equal the cash due
  /// plus the parts' fees (each fee / its part's exchangeRate).
  transactionFee     Decimal  @db.Decimal(18, 2)
  /// Order the parts were entered in.
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  vendorInvoice    VendorInvoice?           @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)
  hardwarePurchase HardwarePurchaseInvoice? @relation(fields: [hardwarePurchaseId], references: [id], onDelete: Cascade)
  entity           AccountingEntity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  bank             AccountingBank           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  currency         AccountingCurrency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([vendorInvoiceId])
  @@index([hardwarePurchaseId])
  @@index([entityId])
  @@index([bankId])
  @@index([currencyId])
  @@map("vendor_payment_parts")
}

// Accounting master data: the entities that pay or receive money, their
// banks, and the currencies each bank holds. Payment forms cascade
// Entity -> Bank -> Currency.
model AccountingEntity {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  isActive                 Boolean                   @default(true)
  createdBy                String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdByUser            User                      @relation("accountingEntitiesCreated", fields: [createdBy], references: [id])
  banks                    AccountingBank[]
  vendorInvoicePayments    VendorInvoice[]           @relation("vendorInvoicePaymentEntity")
  hardwarePurchasePayments HardwarePurchaseInvoice[] @relation("hardwarePurchasePaymentEntity")
  costPayments             CostPayment[]
  vendorPaymentParts       VendorPaymentPart[]
  depositReturns           VendorDepositMovement[]

  @@index([createdBy])
  @@map("accounting_entities")
}

model AccountingBank {
  id                       String                    @id @default(cuid())
  entityId                 String
  name                     String
  isActive                 Boolean                   @default(true)
  createdBy                String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  entity                   AccountingEntity          @relation(fields: [entityId], references: [id])
  createdByUser            User                      @relation("accountingBanksCreated", fields: [createdBy], references: [id])
  currencies               AccountingBankCurrency[]
  vendorInvoicePayments    VendorInvoice[]           @relation("vendorInvoicePaymentBank")
  hardwarePurchasePayments HardwarePurchaseInvoice[] @relation("hardwarePurchasePaymentBank")
  costPayments             CostPayment[]
  vendorPaymentParts       VendorPaymentPart[]
  depositReturns           VendorDepositMovement[]

  @@unique([entityId, name])
  @@index([createdBy])
  @@map("accounting_banks")
}

model AccountingCurrency {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  banks                    AccountingBankCurrency[]
  vendorInvoicePayments    VendorInvoice[]           @relation("vendorInvoicePaymentCurrency")
  hardwarePurchasePayments HardwarePurchaseInvoice[] @relation("hardwarePurchasePaymentCurrency")
  costPayments             CostPayment[]
  vendorPaymentParts       VendorPaymentPart[]
  depositReturns           VendorDepositMovement[]

  @@map("accounting_currencies")
}

model AccountingBankCurrency {
  bankId     String
  currencyId String
  bank       AccountingBank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  currency   AccountingCurrency @relation(fields: [currencyId], references: [id])

  @@id([bankId, currencyId])
  @@index([currencyId])
  @@map("accounting_bank_currencies")
}

model RecurringInvoice {
  id                String    @id @default(cuid())
  userId            String
  dayOfMonth        Int
  unitPrice         Decimal   @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime?
