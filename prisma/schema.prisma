  totalAmount            Decimal               @db.Decimal(12, 2)
  status                 InvoiceStatus
  invoiceType            InvoiceType           @default(ELECTRICITY_CHARGES)
  invoiceGeneratedDate   DateTime
  issuedDate             DateTime?
  dueDate                DateTime
  billingMonth           DateTime? // Format: First day of month (e.g., 2026-04-01 for April 2026)
  machineHostingLocation String[]              @default([])
  paidDate               DateTime?
  createdBy              String
  updatedBy              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
