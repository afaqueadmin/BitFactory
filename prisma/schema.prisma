// Accounting master data: the entities that pay or receive money, their
// banks, and the currencies each bank holds. Payment forms cascade
// Entity -> Bank -> Currency.
model AccountingEntity {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  isActive                 Boolean                   @default(true)
  createdBy                String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdByUser            User                      @relation("accountingEntitiesCreated", fields: [createdBy], references: [id])
  banks                    AccountingBank[]
  vendorInvoicePayments    VendorInvoice[]           @relation("vendorInvoicePaymentEntity")
  hardwarePurchasePayments HardwarePurchaseInvoice[] @relation("hardwarePurchasePaymentEntity")
  costPayments             CostPayment[]

  @@index([createdBy])
  @@map("accounting_entities")
}

model AccountingBank {
  id                       String                    @id @default(cuid())
  entityId                 String
  name                     String
  isActive                 Boolean                   @default(true)
  createdBy                String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  entity                   AccountingEntity          @relation(fields: [entityId], references: [id])
  createdByUser            User                      @relation("accountingBanksCreated", fields: [createdBy], references: [id])
  currencies               AccountingBankCurrency[]
  vendorInvoicePayments    VendorInvoice[]           @relation("vendorInvoicePaymentBank")
  hardwarePurchasePayments HardwarePurchaseInvoice[] @relation("hardwarePurchasePaymentBank")
  costPayments             CostPayment[]

  @@unique([entityId, name])
  @@index([createdBy])
  @@map("accounting_banks")
}

model AccountingCurrency {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  banks                    AccountingBankCurrency[]
  vendorInvoicePayments    VendorInvoice[]           @relation("vendorInvoicePaymentCurrency")
  hardwarePurchasePayments HardwarePurchaseInvoice[] @relation("hardwarePurchasePaymentCurrency")
  costPayments             CostPayment[]

  @@map("accounting_currencies")
}

model AccountingBankCurrency {
  bankId     String
  currencyId String
  bank       AccountingBank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  currency   AccountingCurrency @relation(fields: [currencyId], references: [id])

  @@id([bankId, currencyId])
  @@index([currencyId])
  @@map("accounting_bank_currencies")
}

model RecurringInvoice {
  id                String    @id @default(cuid())
  userId            String
  dayOfMonth        Int
  unitPrice         Decimal   @db.Decimal(10, 2)
  startDate         DateTime
