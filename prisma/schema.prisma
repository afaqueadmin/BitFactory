generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                      String                          @id @default(cuid())
  /// Stored canonical (trimmed, lowercased) - see src/lib/auth/emailIdentity.ts.
  /// Also unique on lower(email) via "users_email_lower_key", an expression
  /// index Prisma can't model (migration 20260929120000_users_email_lower_unique).
  /// Always the primary UserLogin's email - kept here for display, invoices
  /// and PDFs. Sign-in goes through UserLogin, never this column.
  email                                   String                          @unique
  name                                    String?
  /// Legacy: passwords live on UserLogin now. Left in place, not read.
  password                                String
  createdAt                               DateTime                        @default(now())
  updatedAt                               DateTime                        @updatedAt
  companyName                             String?
  profileImage                            String?
  profileImageId                          String?
  city                                    String?
  country                                 String?
  dateOfBirth                             DateTime?
  phoneNumber                             String?
  streetAddress                           String?
  twoFactorEnabled                        Boolean                         @default(false)
  twoFactorSecret                         String?
  twoFactorBackupCodes                    String[]
  role                                    Role                            @default(CLIENT)
  idNumber                                String?
  luxorSubaccountName                     String?
  companyUrl                              String?
  isDeleted                               Boolean                         @default(false)
  /// Tokens issued before this moment are rejected - signs the account out
  /// on every device (src/lib/auth/sessionRevocation.ts). Null = never.
  sessionsValidAfter                      DateTime?
  franchiseeId                            String?
  franchisee                              Franchise?                      @relation("FranchiseUsers", fields: [franchiseeId], references: [id])
  segment                                 Segment?
  auditLogs                               AuditLog[]                      @relation("auditLogs")
  costPayments                            CostPayment[]
  pricingCreated                          CustomerPricingConfig[]         @relation("pricingConfigsCreated")
  pricingUpdated                          CustomerPricingConfig[]         @relation("pricingConfigsUpdated")
  pricingConfigs                          CustomerPricingConfig[]         @relation("pricingConfigs")
  createdGroups                           Group[]
  franchisesOwned                         Franchise[]                     @relation("FranchiseFranchisee")
  franchisesCreated                       Franchise[]                     @relation("FranchiseCreatedBy")
  hardwareProcurementHistory              HardwareProcurementHistory[]
  invoicesCreated                         Invoice[]                       @relation("invoicesCreated")
  invoicesUpdated                         Invoice[]                       @relation("invoicesUpdated")
  invoices                                Invoice[]                       @relation("invoices")
  memos                                   Memo[]                          @relation("memos")
  memosCreated                            Memo[]                          @relation("memosCreated")
  memosVoided                             Memo[]                          @relation("memosVoided")
  vendorInvoicesCreated                   VendorInvoice[]                 @relation("vendorInvoicesCreated")
  vendorInvoicesUpdated                   VendorInvoice[]                 @relation("vendorInvoicesUpdated")
  hardwarePurchasesCreated                HardwarePurchaseInvoice[]       @relation("hardwarePurchasesCreated")
  hardwarePurchasesUpdated                HardwarePurchaseInvoice[]       @relation("hardwarePurchasesUpdated")
  createdMinerHistory                     MinerOwnershipHistory[]         @relation("createdBy")
  ownedMinerHistory                       MinerOwnershipHistory[]         @relation("owner")
  miners                                  Miner[]
  minersCreated                           Miner[]                         @relation("MinerCreatedBy")
  minersUpdated                           Miner[]                         @relation("MinerUpdatedBy")
  minersDeleted                           Miner[]                         @relation("MinerDeletedBy")
  hardwareCreated                         Hardware[]                      @relation("HardwareCreatedBy")
  hardwareUpdated                         Hardware[]                      @relation("HardwareUpdatedBy")
  hardwareDeleted                         Hardware[]                      @relation("HardwareDeletedBy")
  minerRateHistoryCreated                 MinerRateHistory[]              @relation("MinerRateHistoryCreatedBy")
  emailSendRunsCreated                    EmailSendRun[]                  @relation("emailSendRunsCreated")
  emailSendResults                        EmailSendResult[]               @relation("emailSendResults")
  recurringCreated                        RecurringInvoice[]              @relation("recurringInvoicesCreated")
  recurringUpdated                        RecurringInvoice[]              @relation("recurringInvoicesUpdated")
  recurringInvoices                       RecurringInvoice[]              @relation("recurringInvoices")
  blacklisted                             TokenBlacklist[]
  activities                              UserActivity[]
  sessions                                UserSession[]
  paymentDetailsUpdates                   PaymentDetails[]
  poolAuths                               PoolAuth[]
  poolSubaccounts                         PoolSubaccount[]
  webauthnCredentials                     WebAuthnCredential[]
  twoFactorAuths                          TwoFactorAuth[]
  logins                                  UserLogin[]                     @relation("userLogins")
  loginsCreated                           UserLogin[]                     @relation("userLoginsCreated")
  invoicedAmount                          Decimal                         @db.Decimal(12, 2)
  createdRepairNotes                      MinerRepairNote[]               @relation("CreatedRepairNotes")
  createdMinerPoolHistory                 MinerPoolHistory[]              @relation("MinerPoolHistoryCreatedBy")
  createdHashrateBenchmarks               MinerHashrateBenchmark[]        @relation("MinerHashrateBenchmarkCreatedBy")
  acknowledgedHashrateAlerts              MinerHashrateAlertLog[]         @relation("MinerHashrateAlertAcknowledgedBy")
  minerRestartsCreated                    MinerRestart[]                  @relation("MinerRestartCreatedBy")
  addedGroupSubaccounts                   GroupSubaccount[]               @relation("GroupSubaccountAddedBy")
  groupMemberships                        GroupSubaccount[]               @relation("GroupSubaccountUser")
  customerRequestsSubmitted               FranchiseCustomerRequest[]      @relation("CustomerRequestsSubmitted")
  customerRequestsReviewed                FranchiseCustomerRequest[]      @relation("CustomerRequestsReviewed")
  customerRequestCreatedFrom              FranchiseCustomerRequest?       @relation("CustomerRequestsCreatedUser")
  incentiveRatesCreated                   FranchiseIncentiveRate[]        @relation("incentiveRatesCreated")
  incentiveRatesUpdated                   FranchiseIncentiveRate[]        @relation("incentiveRatesUpdated")
  incentiveEntriesAsClient                IncentiveEntry[]                @relation("incentiveEntriesClient")
  incentivePayoutsCreated                 IncentivePayoutBatch[]          @relation("incentivePayoutsCreated")
  ticketsRaised                           SupportTicket[]                 @relation("ticketsRaised")
  ticketsAssigned                         SupportTicket[]                 @relation("ticketsAssigned")
  ticketsRaisedOnBehalf                   SupportTicket[]                 @relation("ticketsOnBehalfOf")
  ticketMessages                          TicketMessage[]                 @relation("ticketMessagesAuthored")
  walletChangeRequests                    WalletChangeRequest[]           @relation("walletChangeRequests")
  walletChangeRequestsConfirmed           WalletChangeRequest[]           @relation("walletChangeRequestsConfirmed")
  walletChangeRequestsReviewed            WalletChangeRequest[]           @relation("walletChangeRequestsReviewed")
  paymentFrequencyChangeRequests          PaymentFrequencyChangeRequest[] @relation("paymentFrequencyChangeRequests")
  paymentFrequencyChangeRequestsConfirmed PaymentFrequencyChangeRequest[] @relation("paymentFrequencyChangeRequestsConfirmed")
  paymentFrequencyChangeRequestsReviewed  PaymentFrequencyChangeRequest[] @relation("paymentFrequencyChangeRequestsReviewed")
  firmwareChangeRequests                  FirmwareChangeRequest[]         @relation("firmwareChangeRequests")
  firmwareChangeRequestsConfirmed         FirmwareChangeRequest[]         @relation("firmwareChangeRequestsConfirmed")
  firmwareChangeRequestsReviewed          FirmwareChangeRequest[]         @relation("firmwareChangeRequestsReviewed")
  firmwareOptionsCreated                  FirmwareOption[]                @relation("firmwareOptionsCreated")
  secondaryLoginRequests                  SecondaryLoginRequest[]         @relation("secondaryLoginRequests")
  secondaryLoginRequestsReviewed          SecondaryLoginRequest[]         @relation("secondaryLoginRequestsReviewed")
  accountingEntitiesCreated               AccountingEntity[]              @relation("accountingEntitiesCreated")
  accountingBanksCreated                  AccountingBank[]                @relation("accountingBanksCreated")
  accountingVendorsCreated                AccountingVendor[]              @relation("accountingVendorsCreated")
  vendorDepositMovementsCreated           VendorDepositMovement[]         @relation("vendorDepositMovementsCreated")
  simulatedCostPayments                   SimulatedCostPayment[]          @relation("simulatedCostPayments")
  simulatedCostPaymentsCreated            SimulatedCostPayment[]          @relation("simulatedCostPaymentsCreated")
  walletPaymentEmails                     WalletPaymentEmail[]
  simulationSettingsUpdated               SimulationSettings[]            @relation("simulationSettingsUpdated")
  guildMastered                           Guild?                          @relation("guildsMastered")
  guildsCreated                           Guild[]                         @relation("guildsCreated")
  guildMembership                         GuildMembership?                @relation("guildMembership")
  guildWalletRequests                     GuildWalletChangeRequest[]      @relation("guildWalletRequests")
  guildWalletRequestsConfirmed            GuildWalletChangeRequest[]      @relation("guildWalletRequestsConfirmed")
  guildWalletRequestsReviewed             GuildWalletChangeRequest[]      @relation("guildWalletRequestsReviewed")
  guildSplitRequests                      GuildSplitChangeRequest[]       @relation("guildSplitRequests")
  guildSplitRequestsConfirmed             GuildSplitChangeRequest[]       @relation("guildSplitRequestsConfirmed")
  guildSplitRequestsReviewed              GuildSplitChangeRequest[]       @relation("guildSplitRequestsReviewed")
  guildMemberRequests                     GuildMemberChangeRequest[]      @relation("guildMemberRequests")
  guildMemberRequestsConfirmed            GuildMemberChangeRequest[]      @relation("guildMemberRequestsConfirmed")
  guildMemberRequestsReviewed             GuildMemberChangeRequest[]      @relation("guildMemberRequestsReviewed")
  guildPayoutBatchesCreated               GuildPayoutBatch[]              @relation("guildPayoutBatchesCreated")
  guildPayoutSettingsUpdated              GuildPayoutSettings[]           @relation("guildPayoutSettingsUpdated")
  guildDistributionLines                  GuildDistributionLine[]         @relation("guildDistributionLines")

  @@index([isDeleted])
  @@index([franchiseeId])
  @@index([segment])
  @@map("users")
}

model Franchise {
  id                     String                     @id @default(cuid())
  businessName           String
  authorizedPersonName   String
  email                  String
  phoneNumber            String
  address                String
  city                   String
  state                  String
  postalCode             String
  franchiseCode          String                     @unique
  createdById            String
  createdBy              User                       @relation("FranchiseCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime                   @default(now())
  isActive               Boolean                    @default(true)
  deletedAt              DateTime?
  franchiseeId           String
  franchisee             User                       @relation("FranchiseFranchisee", fields: [franchiseeId], references: [id])
  users                  User[]                     @relation("FranchiseUsers")
  customerRequests       FranchiseCustomerRequest[]
  incentiveRates         FranchiseIncentiveRate[]
  incentiveEntries       IncentiveEntry[]
  incentivePayoutBatches IncentivePayoutBatch[]
  tickets                SupportTicket[]

  @@index([franchiseeId])
  @@index([createdById])
  @@index([isActive])
  @@index([deletedAt])
  @@map("franchises")
}

// A franchisee-submitted request to onboard a new customer. Franchisees
// cannot create customers directly — an admin must approve the request,
// which then creates the actual User (CLIENT, RETAIL, attached to the
// requesting franchise).
model FranchiseCustomerRequest {
  id                  String        @id @default(cuid())
  franchiseId         String
  franchise           Franchise     @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  requestedById       String
  requestedBy         User          @relation("CustomerRequestsSubmitted", fields: [requestedById], references: [id])
  name                String
  email               String
  phoneNumber         String?
  luxorSubaccountName String?
  initialDeposit      Decimal?      @db.Decimal(12, 2)
  status              RequestStatus @default(PENDING)
  rejectionReason     String?
  reviewedById        String?
  reviewedBy          User?         @relation("CustomerRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  createdUserId       String?       @unique
  createdUser         User?         @relation("CustomerRequestsCreatedUser", fields: [createdUserId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([franchiseId])
  @@index([status])
  @@index([requestedById])
  @@map("franchise_customer_requests")
}

enum RequestStatus {
  PENDING
  CONFIRMED
  APPROVED
  REJECTED
}

// A client-submitted request to change the payout wallet address on their
// Luxor subaccount. currentAddress snapshots the live Luxor address at
// request time so the request row itself is a permanent audit record of
// what the address was and what it changed to - no separate history table.
// Review is two steps: an admin confirms the change with the client
// (/api/wallet/change-requests/[id]/confirm), then approves it
// (.../approve), which starts the client's 24-hour payout freeze window.
// Nothing is pushed to Luxor at either step - the admin updates the payout
// address on Luxor manually, outside this app. Braiins is out of scope: braiins.ts has no equivalent "configured payout
// address" API to read or write against.
model WalletChangeRequest {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation("walletChangeRequests", fields: [userId], references: [id])
  currency             String        @default("BTC")
  // Which Luxor subaccount this request is for - a snapshot (like
  // currentAddress), not a live FK, since that's all the admin needs to
  // know which one to update manually on Luxor. Null on rows submitted
  // before multi-subaccount support existed.
  subaccountName       String?
  /// Snapshot of the sign-in email that submitted it - the account can have
  /// a second login. Null on rows from before this was recorded.
  requestedByEmail     String?
  requestedBySecondary Boolean       @default(false)
  currentAddress       String?
  requestedAddress     String
  reason               String?       @db.Text
  status               RequestStatus @default(PENDING)
  rejectionReason      String?
  confirmedById        String?
  confirmedBy          User?         @relation("walletChangeRequestsConfirmed", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  confirmationMethod   String?
  confirmationContact  String?
  confirmationNote     String?       @db.Text
  reviewedById         String?
  reviewedBy           User?         @relation("walletChangeRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("wallet_change_requests")
}

// A client-submitted request to change the payout schedule (payment
// frequency, plus day of week for WEEKLY) on one of their Luxor subaccounts.
// Same two-step review as WalletChangeRequest - an admin confirms the change
// with the client, then approves it - but with no payout freeze afterwards,
// since the payout destination isn't changing. currentFrequency /
// currentDayOfWeek snapshot the live Luxor schedule at request time (null if
// Luxor couldn't be reached) so the row is a permanent before/after record.
// Nothing is pushed to Luxor at any step - the admin updates the schedule on
// Luxor manually, outside this app. At most one PENDING/CONFIRMED request per
// subaccount at a time.
model PaymentFrequencyChangeRequest {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation("paymentFrequencyChangeRequests", fields: [userId], references: [id])
  currency             String        @default("BTC")
  // Luxor subaccount snapshot, not a live FK - see WalletChangeRequest.
  subaccountName       String
  /// Who submitted it - see WalletChangeRequest.requestedByEmail.
  requestedByEmail     String?
  requestedBySecondary Boolean       @default(false)
  currentFrequency     String?
  currentDayOfWeek     String?
  // DAILY | WEEKLY | MONTHLY; requestedDayOfWeek is set only for WEEKLY.
  requestedFrequency   String
  requestedDayOfWeek   String?
  reason               String?       @db.Text
  status               RequestStatus @default(PENDING)
  rejectionReason      String?
  confirmedById        String?
  confirmedBy          User?         @relation("paymentFrequencyChangeRequestsConfirmed", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  confirmationMethod   String?
  confirmationContact  String?
  confirmationNote     String?       @db.Text
  reviewedById         String?
  reviewedBy           User?         @relation("paymentFrequencyChangeRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([subaccountName])
  @@map("payment_frequency_change_requests")
}

// Admin-managed list of firmware a client can ask to have flashed onto one of
// their miners (see FirmwareChangeRequest). An option a request has used
// can't be deleted - the FK below is Restrict - only deactivated, which hides
// it from clients.
model FirmwareOption {
  id          String                  @id @default(cuid())
  name        String                  @unique
  isActive    Boolean                 @default(true)
  createdById String
  createdBy   User                    @relation("firmwareOptionsCreated", fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  requests    FirmwareChangeRequest[]

  @@map("firmware_options")
}

// A client-submitted request to change the firmware on one of their Luxor
// miners. Same two-step review as PaymentFrequencyChangeRequest - an admin
// confirms the change with the client, then approves it. Nothing is changed
// by this app at any step - the admin flashes the firmware on the miner
// manually. currentFirmware snapshots Luxor's live worker.firmware at request
// time (null if Luxor couldn't be reached), and requestedFirmwareName
// snapshots the option's name, so the row stays a permanent before/after
// record even if the option is renamed later. At most one PENDING/CONFIRMED
// request per miner at a time.
model FirmwareChangeRequest {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation("firmwareChangeRequests", fields: [userId], references: [id])
  minerId               String
  miner                 Miner          @relation(fields: [minerId], references: [id], onDelete: Restrict)
  /// Snapshot of Miner.name (the Luxor worker name) at request time.
  minerName             String
  /// Luxor subaccount the worker was found on - a snapshot, not a live FK.
  subaccountName        String?
  /// Who submitted it - see WalletChangeRequest.requestedByEmail.
  requestedByEmail      String?
  requestedBySecondary  Boolean        @default(false)
  currentFirmware       String?
  requestedFirmwareId   String
  requestedFirmware     FirmwareOption @relation(fields: [requestedFirmwareId], references: [id], onDelete: Restrict)
  requestedFirmwareName String
  reason                String?        @db.Text
  status                RequestStatus  @default(PENDING)
  rejectionReason       String?
  confirmedById         String?
  confirmedBy           User?          @relation("firmwareChangeRequestsConfirmed", fields: [confirmedById], references: [id])
  confirmedAt           DateTime?
  confirmationMethod    String?
  confirmationContact   String?
  confirmationNote      String?        @db.Text
  reviewedById          String?
  reviewedBy            User?          @relation("firmwareChangeRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([minerId])
  @@index([requestedFirmwareId])
  @@map("firmware_change_requests")
}

// A client's request for a second sign-in email (a UserLogin) on their
// account. An admin approves it in one step, which adds the login exactly
// like Edit Customer does (src/lib/auth/addSecondaryLogin.ts), or rejects it
// with a reason.
model SecondaryLoginRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("secondaryLoginRequests", fields: [userId], references: [id])
  requestedEmail   String
  reason           String?       @db.Text
  /// The sign-in email that submitted it.
  requestedByEmail String?
  status           RequestStatus @default(PENDING)
  rejectionReason  String?
  reviewedById     String?
  reviewedBy       User?         @relation("secondaryLoginRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  /// The login created on approval - a snapshot, not a live FK, since the
  /// login can be removed later.
  createdLoginId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("secondary_login_requests")
}

// ============================================================================
// Guilds: a group that jointly owns the miners in one Luxor subaccount. The
// Guildmaster is the point of contact; Guildmembers have view-only access to
// the whole guild. ("Guild", not "pool" - pool means Luxor/Braiins here.)
//
// The guild's miners, subaccount, invoices and ledger sit on the current
// Guildmaster's account so billing stays per-user; a handover moves them all
// to the new Guildmaster (src/lib/guilds/handover.ts). Luxor pays the guild's
// reward monthly to a Higgs wallet; GuildDistribution records how each payout
// is split (src/lib/guilds/distribution.ts).
// ============================================================================

model Guild {
  id                   String                     @id @default(cuid())
  name                 String
  guildmasterId        String                     @unique
  guildmaster          User                       @relation("guildsMastered", fields: [guildmasterId], references: [id])
  /// The guild's Luxor subaccount (a PoolAuth on the Guildmaster's account).
  poolAuthId           String?                    @unique
  poolAuth             PoolAuth?                  @relation(fields: [poolAuthId], references: [id], onDelete: SetNull)
  isActive             Boolean                    @default(true)
  /// When an approved split change last took effect - distributions wait
  /// out the 24h freeze after it.
  splitUpdatedAt       DateTime?
  /// The guild's own receiving address - set as its Luxor subaccount's
  /// payout address. Typed in by an admin for now; derived from the payout
  /// wallet (payoutAddressIndex) once multisig payouts are live.
  payoutAddress        String?                    @unique
  payoutAddressIndex   Int?                       @unique
  /// How this guild is paid; null = GuildPayoutSettings.defaultPayoutMethod.
  /// Lets a new method be trialled on one guild.
  payoutMethod         GuildPayoutMethod?
  createdById          String
  createdBy            User                       @relation("guildsCreated", fields: [createdById], references: [id])
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime?
  memberships          GuildMembership[]
  walletChangeRequests GuildWalletChangeRequest[]
  splitChangeRequests  GuildSplitChangeRequest[]
  memberChangeRequests GuildMemberChangeRequest[]
  distributions        GuildDistribution[]

  @@index([isActive])
  @@map("guilds")
}

// One row per person in a guild, the Guildmaster included, so the reward
// split and wallets live in one place. Active rows (leftAt null) sum to 100%.
// userId is unique: a person belongs to at most one guild, ever.
model GuildMembership {
  id                 String                         @id @default(cuid())
  guildId            String
  guild              Guild                          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId             String                         @unique
  user               User                           @relation("guildMembership", fields: [userId], references: [id])
  isGuildmaster      Boolean                        @default(false)
  rewardPercent      Decimal                        @db.Decimal(7, 4)
  /// Where this person's share is sent. Saved here, not on Luxor - Luxor
  /// pays the whole guild reward to a Higgs wallet.
  walletAddress      String?
  /// Which chain walletAddress is on (src/lib/guilds/walletNetworks.ts).
  /// Only "BTC" today; a string so another chain needs no schema change.
  walletNetwork      String                         @default("BTC")
  /// When an approved wallet change last took effect (24h freeze).
  walletUpdatedAt    DateTime?
  /// Earned but not yet sent: small shares wait until they reach
  /// GuildPayoutSettings.minPayoutSats, and a share is held back while its
  /// wallet is missing or in its 24h freeze. Updated when a payout settles.
  carriedBtc         Decimal                        @default(0) @db.Decimal(20, 8)
  joinedAt           DateTime                       @default(now())
  leftAt             DateTime?
  walletRequests     GuildWalletChangeRequest[]
  splitRequestLines  GuildSplitChangeRequestLine[]
  memberRequests     GuildMemberChangeRequest[]     @relation("guildMemberRequestTarget")
  memberRequestAdded GuildMemberChangeRequest?      @relation("guildMemberRequestCreated")
  memberRequestLines GuildMemberChangeRequestLine[]
  distributionLines  GuildDistributionLine[]

  @@index([guildId])
  @@map("guild_memberships")
}

// The Guildmaster's request to change one member's (or their own) reward
// wallet. Same confirm -> approve review as WalletChangeRequest; approval
// writes the wallet to GuildMembership and starts its 24h freeze.
model GuildWalletChangeRequest {
  id                   String          @id @default(cuid())
  guildId              String
  guild                Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  membershipId         String
  membership           GuildMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  requestedById        String
  requestedBy          User            @relation("guildWalletRequests", fields: [requestedById], references: [id])
  /// Who submitted it - see WalletChangeRequest.requestedByEmail.
  requestedByEmail     String?
  requestedBySecondary Boolean         @default(false)
  network              String          @default("BTC")
  currentAddress       String?
  requestedAddress     String
  reason               String?         @db.Text
  status               RequestStatus   @default(PENDING)
  rejectionReason      String?
  confirmedById        String?
  confirmedBy          User?           @relation("guildWalletRequestsConfirmed", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  confirmationMethod   String?
  confirmationContact  String?
  confirmationNote     String?         @db.Text
  reviewedById         String?
  reviewedBy           User?           @relation("guildWalletRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([guildId])
  @@index([membershipId])
  @@index([status])
  @@map("guild_wallet_change_requests")
}

// The Guildmaster's request for a new reward split: one line per active
// member (themselves included), requested percentages summing to 100.
// Same confirm -> approve review; approval writes every line's percent.
model GuildSplitChangeRequest {
  id                   String                        @id @default(cuid())
  guildId              String
  guild                Guild                         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  requestedById        String
  requestedBy          User                          @relation("guildSplitRequests", fields: [requestedById], references: [id])
  requestedByEmail     String?
  requestedBySecondary Boolean                       @default(false)
  reason               String?                       @db.Text
  status               RequestStatus                 @default(PENDING)
  rejectionReason      String?
  confirmedById        String?
  confirmedBy          User?                         @relation("guildSplitRequestsConfirmed", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  confirmationMethod   String?
  confirmationContact  String?
  confirmationNote     String?                       @db.Text
  reviewedById         String?
  reviewedBy           User?                         @relation("guildSplitRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  lines                GuildSplitChangeRequestLine[]

  @@index([guildId])
  @@index([status])
  @@map("guild_split_change_requests")
}

model GuildSplitChangeRequestLine {
  id               String                  @id @default(cuid())
  requestId        String
  request          GuildSplitChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  membershipId     String
  membership       GuildMembership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  currentPercent   Decimal                 @db.Decimal(7, 4)
  requestedPercent Decimal                 @db.Decimal(7, 4)

  @@unique([requestId, membershipId])
  @@index([membershipId])
  @@map("guild_split_change_request_lines")
}

// The Guildmaster's request to add a member (with their reward %) or remove
// one. lines give the new split for everyone who stays (every active member
// for ADD; everyone but the leaver for REMOVE), summing to 100 with the new
// person's percent. Same confirm -> approve review as the other guild
// requests; the account is created (and its welcome email sent) or closed
// only on approval (src/lib/guilds/members.ts).
model GuildMemberChangeRequest {
  id                   String                         @id @default(cuid())
  guildId              String
  guild                Guild                          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  action               GuildMemberChangeAction
  /// ADD: the person to add.
  newName              String?
  newEmail             String?
  newPhoneNumber       String?
  newPercent           Decimal?                       @db.Decimal(7, 4)
  newWalletAddress     String?
  newWalletNetwork     String                         @default("BTC")
  /// ADD: the membership created on approval.
  createdMembershipId  String?                        @unique
  createdMembership    GuildMembership?               @relation("guildMemberRequestCreated", fields: [createdMembershipId], references: [id], onDelete: SetNull)
  /// REMOVE: the member leaving.
  membershipId         String?
  membership           GuildMembership?               @relation("guildMemberRequestTarget", fields: [membershipId], references: [id], onDelete: Cascade)
  requestedById        String
  requestedBy          User                           @relation("guildMemberRequests", fields: [requestedById], references: [id])
  requestedByEmail     String?
  requestedBySecondary Boolean                        @default(false)
  reason               String?                        @db.Text
  status               RequestStatus                  @default(PENDING)
  rejectionReason      String?
  confirmedById        String?
  confirmedBy          User?                          @relation("guildMemberRequestsConfirmed", fields: [confirmedById], references: [id])
  confirmedAt          DateTime?
  confirmationMethod   String?
  confirmationContact  String?
  confirmationNote     String?                        @db.Text
  reviewedById         String?
  reviewedBy           User?                          @relation("guildMemberRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  lines                GuildMemberChangeRequestLine[]

  @@index([guildId])
  @@index([membershipId])
  @@index([status])
  @@map("guild_member_change_requests")
}

model GuildMemberChangeRequestLine {
  id               String                   @id @default(cuid())
  requestId        String
  request          GuildMemberChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  membershipId     String
  membership       GuildMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  currentPercent   Decimal                  @db.Decimal(7, 4)
  requestedPercent Decimal                  @db.Decimal(7, 4)

  @@unique([requestId, membershipId])
  @@index([membershipId])
  @@map("guild_member_change_request_lines")
}

enum GuildMemberChangeAction {
  ADD
  REMOVE
}

enum GuildDistributionStatus {
  /// Calculated and ready to send.
  CALCULATED
  /// Can't be sent as it stands (bad split, split freeze, received amount
  /// doesn't match Luxor) - see holdReason.
  HELD
  /// Picked up by a payout batch that hasn't been sent yet.
  QUEUED
  /// Sent, waiting for enough confirmations.
  BROADCAST
  /// Confirmed: hosting payments recorded, members paid, carried updated.
  SETTLED
  FAILED
}

enum GuildPayoutMethod {
  /// An admin sends the BTC and records the reference.
  MANUAL
  /// The app builds and broadcasts a 2-of-3 multisig batch (Phase 2b).
  MULTISIG_BTC
}

enum GuildFeePayer {
  /// Out of the company output; hosting invoices are still credited in full.
  HIGGS
  /// Out of the company output, and the hosting credit is reduced by it.
  HOSTING_SHARE
  /// Out of the guild's reward before the split.
  GUILD_REWARD
}

enum GuildPayoutBatchStatus {
  BUILDING
  BROADCAST
  CONFIRMED
  FAILED
}

/// Payout settings for every guild. One row (id = 1).
model GuildPayoutSettings {
  id                   Int               @id @default(1)
  feePayer             GuildFeePayer     @default(HIGGS)
  /// A member's payable amount below this stays carried.
  minPayoutSats        Int               @default(10000)
  minConfirmations     Int               @default(3)
  defaultPayoutMethod  GuildPayoutMethod @default(MANUAL)
  /// Send automatically once calculated (multisig only).
  autoExecute          Boolean           @default(false)
  /// Where the hosting (company) share goes.
  companyWalletAddress String?
  /// Public descriptor of the 2-of-3 payout wallet - watch-only, no keys.
  walletDescriptor     String?
  network              String            @default("mainnet")
  /// Next derivation index for a guild receiving address.
  nextAddressIndex     Int               @default(0)
  updatedById          String?
  updatedBy            User?             @relation("guildPayoutSettingsUpdated", fields: [updatedById], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("guild_payout_settings")
}

// One payout run: a single transfer (one Bitcoin transaction in multisig
// mode, or what an admin sent by hand) covering one or more guilds'
// distributions.
model GuildPayoutBatch {
  id            String                 @id @default(cuid())
  method        GuildPayoutMethod
  status        GuildPayoutBatchStatus @default(BUILDING)
  /// The Bitcoin transaction id; in manual mode, the reference the admin
  /// recorded.
  txid          String?                @unique
  feeBtc        Decimal                @default(0) @db.Decimal(20, 8)
  feeRateSatVb  Decimal?               @db.Decimal(10, 2)
  confirmations Int                    @default(0)
  companyBtc    Decimal                @db.Decimal(20, 8)
  paidBtc       Decimal                @db.Decimal(20, 8)
  error         String?
  createdById   String?
  createdBy     User?                  @relation("guildPayoutBatchesCreated", fields: [createdById], references: [id])
  broadcastAt   DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  distributions GuildDistribution[]

  @@index([status])
  @@map("guild_payout_batches")
}

// One monthly Luxor payout to a guild and how it is split: the hosting
// invoices it pays (company share) and each person's share of the rest.
// Amounts and wallets are snapshots taken when it was calculated.
model GuildDistribution {
  id                  String                  @id @default(cuid())
  guildId             String
  guild               Guild                   @relation(fields: [guildId], references: [id], onDelete: Restrict)
  /// The month the reward was earned (first day, UTC). Luxor pays it early
  /// the following month.
  rewardMonth         DateTime                @db.Date
  /// The Luxor "Payment" debit this splits.
  payoutTransactionId String?                 @unique
  payoutTransaction   PoolTransaction?        @relation(fields: [payoutTransactionId], references: [id], onDelete: SetNull)
  payoutOccurredAt    DateTime
  luxorPayoutBtc      Decimal                 @db.Decimal(20, 8)
  /// The coin that payout left at the guild's address (multisig mode).
  receivedTxid        String?
  receivedVout        Int?
  receivedBtc         Decimal?                @db.Decimal(20, 8)
  btcUsdRate          Decimal                 @db.Decimal(12, 2)
  rateSource          String
  /// Unpaid guild hosting invoices at calculation time, USD.
  hostingDueUsd       Decimal                 @db.Decimal(12, 2)
  companyBtc          Decimal                 @db.Decimal(20, 8)
  companyUsd          Decimal                 @db.Decimal(12, 2)
  netBtc              Decimal                 @db.Decimal(20, 8)
  /// This guild's part of the payout transaction's network fee.
  networkFeeBtc       Decimal                 @default(0) @db.Decimal(20, 8)
  /// Hosting left unpaid after this payout, USD (0 when fully covered).
  shortfallUsd        Decimal                 @default(0) @db.Decimal(12, 2)
  /// [{ invoiceId, invoiceNumber, amountUsd }] - which invoices companyUsd pays.
  hostingAllocations  Json
  status              GuildDistributionStatus @default(CALCULATED)
  holdReason          String?
  shortfallNotifiedAt DateTime?
  payoutBatchId       String?
  payoutBatch         GuildPayoutBatch?       @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  settledAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  lines               GuildDistributionLine[]

  @@unique([guildId, rewardMonth])
  @@unique([receivedTxid, receivedVout])
  @@index([status])
  @@index([payoutBatchId])
  @@map("guild_distributions")
}

model GuildDistributionLine {
  id              String            @id @default(cuid())
  distributionId  String
  distribution    GuildDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  membershipId    String
  membership      GuildMembership   @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  userId          String
  user            User              @relation("guildDistributionLines", fields: [userId], references: [id])
  nameSnapshot    String
  isGuildmaster   Boolean
  percentSnapshot Decimal           @db.Decimal(7, 4)
  walletSnapshot  String?
  networkSnapshot String            @default("BTC")
  /// This month's share of the reward.
  btcAmount       Decimal           @db.Decimal(20, 8)
  /// Carried from earlier months, added to this month's share.
  carriedInBtc    Decimal           @default(0) @db.Decimal(20, 8)
  /// Actually sent this month (share + carried in, or 0 if carried).
  paidBtc         Decimal           @default(0) @db.Decimal(20, 8)
  /// Carried to next month.
  carriedOutBtc   Decimal           @default(0) @db.Decimal(20, 8)
  /// Why it was carried (below the minimum, no wallet, wallet freeze).
  carryReason     String?
  /// This member's output in the payout transaction (multisig mode).
  payoutVout      Int?

  @@unique([distributionId, membershipId])
  @@index([userId])
  @@map("guild_distribution_lines")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@map("token_blacklist")
}

// One row per recorded attempt against a rate-limited auth action. `key` is
// "<scope>:<axis>:<identifier>" (see src/lib/rateLimit.ts). Standalone on
// purpose - no relation to users, so it can never affect user rows.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("auth_attempts")
}

// One way into an account: an email with its own password, 2FA and passkeys.
// Every account has exactly one primary login (its email mirrors User.email);
// a CLIENT account may also have one secondary login, added by an admin, so
// a second person (e.g. an accountant) can sign in separately to the same
// account. Account data stays on User; only credentials live here.
// Raw-SQL indexes Prisma can't model (migration 20261014090000_user_logins):
//   "user_logins_email_lower_key"   unique on lower(email)
//   "user_logins_one_primary_key"   unique on userId WHERE "isPrimary"
model UserLogin {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation("userLogins", fields: [userId], references: [id], onDelete: Cascade)
  /// Canonical (trimmed, lowercased) - see src/lib/auth/emailIdentity.ts.
  email               String               @unique
  password            String
  isPrimary           Boolean              @default(false)
  /// Tokens of this login issued before this moment are rejected - signs this
  /// one person out everywhere (User.sessionsValidAfter does the whole account).
  sessionsValidAfter  DateTime?
  lastLoginAt         DateTime?
  createdById         String?
  createdBy           User?                @relation("userLoginsCreated", fields: [createdById], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  twoFactorAuth       TwoFactorAuth?
  webauthnCredentials WebAuthnCredential[]
  activities          UserActivity[]
  sessions            UserSession[]

  @@index([userId])
  @@map("user_logins")
}

model WebAuthnCredential {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginId String
  login   UserLogin @relation(fields: [loginId], references: [id], onDelete: Cascade)

  credentialId Bytes @unique
  publicKey    Bytes
  counter      Int   @default(0)

  transports String[] @default([])
  aaguid     String?

  credentialName String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  @@index([userId])
  @@index([loginId])
  @@map("webauthn_credentials")
}

// One row per login that has ever engaged with 2FA (created lazily on first
// /api/auth/2fa/setup call, or backfilled from the legacy users.twoFactor*
// columns for pre-existing accounts). Those legacy columns on User are left
// in place as a fallback and are not written to going forward. Keyed by
// login, so each person on an account has their own authenticator.
model TwoFactorAuth {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginId       String    @unique
  login         UserLogin @relation(fields: [loginId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  secret        String?
  /// New secret from a setup in progress. Becomes `secret` only once a code
  /// from it is confirmed, so starting setup never switches off working 2FA.
  pendingSecret String?
  backupCodes   String[]
  enrolledAt    DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("two_factor_auth")
}

model UserActivity {
  id        String     @id @default(cuid())
  userId    String
  /// Which login (person) did it. Null on rows from before multi-login, or
  /// when the login has since been removed.
  loginId   String?
  login     UserLogin? @relation(fields: [loginId], references: [id], onDelete: SetNull)
  type      String
  ipAddress String
  userAgent String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loginId])
  @@map("user_activities")
}

model UserSession {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  loginId   String?
  login     UserLogin? @relation(fields: [loginId], references: [id], onDelete: SetNull)
  loginAt   DateTime   @default(now())
  logoutAt  DateTime?
  duration  Int?
  ipAddress String?
  userAgent String?
  tabVisits TabVisit[]
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model TabVisit {
  id        String      @id @default(cuid())
  sessionId String
  session   UserSession @relation(fields: [sessionId], references: [id])
  userId    String
  tabKey    String
  tabName   String
  visitedAt DateTime    @default(now())

  @@index([sessionId])
  @@index([userId])
  @@map("tab_visits")
}

enum PaybackProfileType {
  CLIENT
  COMPANY
}

model PaybackConfig {
