generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  name                       String?
  password                   String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  companyName                String?
  profileImage               String?
  profileImageId             String?
  city                       String?
  country                    String?
  dateOfBirth                DateTime?
  phoneNumber                String?
  streetAddress              String?
  twoFactorEnabled           Boolean                      @default(false)
  twoFactorSecret            String?
  twoFactorBackupCodes       String[]
  role                       Role                         @default(CLIENT)
  idNumber                   String?
  luxorSubaccountName        String?
  companyUrl                 String?
  isDeleted                  Boolean                      @default(false)
  franchiseeId               String?
  franchisee                 Franchise?                   @relation("FranchiseUsers", fields: [franchiseeId], references: [id])
  segment                    Segment?
  auditLogs                  AuditLog[]                   @relation("auditLogs")
  costPayments               CostPayment[]
  pricingCreated             CustomerPricingConfig[]      @relation("pricingConfigsCreated")
  pricingUpdated             CustomerPricingConfig[]      @relation("pricingConfigsUpdated")
  pricingConfigs             CustomerPricingConfig[]      @relation("pricingConfigs")
  createdGroups              Group[]
  franchisesOwned            Franchise[]                  @relation("FranchiseFranchisee")
  franchisesCreated          Franchise[]                  @relation("FranchiseCreatedBy")
  hardwareProcurementHistory HardwareProcurementHistory[]
  invoicesCreated            Invoice[]                    @relation("invoicesCreated")
  invoicesUpdated            Invoice[]                    @relation("invoicesUpdated")
  invoices                   Invoice[]                    @relation("invoices")
  memos                      Memo[]                       @relation("memos")
  memosCreated               Memo[]                       @relation("memosCreated")
  memosVoided                Memo[]                       @relation("memosVoided")
  vendorInvoicesCreated      VendorInvoice[]              @relation("vendorInvoicesCreated")
  vendorInvoicesUpdated      VendorInvoice[]              @relation("vendorInvoicesUpdated")
  hardwarePurchasesCreated   HardwarePurchaseInvoice[]    @relation("hardwarePurchasesCreated")
  hardwarePurchasesUpdated   HardwarePurchaseInvoice[]    @relation("hardwarePurchasesUpdated")
  createdMinerHistory        MinerOwnershipHistory[]      @relation("createdBy")
  ownedMinerHistory          MinerOwnershipHistory[]      @relation("owner")
  miners                     Miner[]
  emailSendRunsCreated       EmailSendRun[]               @relation("emailSendRunsCreated")
  emailSendResults           EmailSendResult[]            @relation("emailSendResults")
  recurringCreated           RecurringInvoice[]           @relation("recurringInvoicesCreated")
  recurringUpdated           RecurringInvoice[]           @relation("recurringInvoicesUpdated")
  recurringInvoices          RecurringInvoice[]           @relation("recurringInvoices")
  blacklisted                TokenBlacklist[]
  activities                 UserActivity[]
  sessions                   UserSession[]
  paymentDetailsUpdates      PaymentDetails[]
  poolAuths                  PoolAuth[]
  poolSubaccounts            PoolSubaccount[]
  webauthnCredentials        WebAuthnCredential[]
  invoicedAmount             Decimal                      @db.Decimal(12, 2)
  createdRepairNotes         MinerRepairNote[]            @relation("CreatedRepairNotes")
  createdMinerPoolHistory    MinerPoolHistory[]           @relation("MinerPoolHistoryCreatedBy")
  addedGroupSubaccounts      GroupSubaccount[]            @relation("GroupSubaccountAddedBy")
  groupMemberships           GroupSubaccount[]            @relation("GroupSubaccountUser")
  customerRequestsSubmitted  FranchiseCustomerRequest[]   @relation("CustomerRequestsSubmitted")
  customerRequestsReviewed   FranchiseCustomerRequest[]   @relation("CustomerRequestsReviewed")
  customerRequestCreatedFrom FranchiseCustomerRequest?    @relation("CustomerRequestsCreatedUser")
  incentiveRatesCreated      FranchiseIncentiveRate[]     @relation("incentiveRatesCreated")
  incentiveRatesUpdated      FranchiseIncentiveRate[]     @relation("incentiveRatesUpdated")
  incentiveEntriesAsClient   IncentiveEntry[]             @relation("incentiveEntriesClient")
  incentivePayoutsCreated    IncentivePayoutBatch[]       @relation("incentivePayoutsCreated")
  ticketsRaised              SupportTicket[]              @relation("ticketsRaised")
  ticketsAssigned            SupportTicket[]              @relation("ticketsAssigned")
  ticketsRaisedOnBehalf      SupportTicket[]              @relation("ticketsOnBehalfOf")
  ticketMessages             TicketMessage[]              @relation("ticketMessagesAuthored")
  walletChangeRequests       WalletChangeRequest[]        @relation("walletChangeRequests")
  walletChangeRequestsReviewed WalletChangeRequest[]       @relation("walletChangeRequestsReviewed")

  @@index([isDeleted])
  @@index([franchiseeId])
  @@index([segment])
  @@map("users")
}

model Franchise {
  id                     String                     @id @default(cuid())
  businessName           String
  authorizedPersonName   String
  email                  String
  phoneNumber            String
  address                String
  city                   String
  state                  String
  postalCode             String
  franchiseCode          String                     @unique
  createdById            String
  createdBy              User                       @relation("FranchiseCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime                   @default(now())
  isActive               Boolean                    @default(true)
  deletedAt              DateTime?
  franchiseeId           String
  franchisee             User                       @relation("FranchiseFranchisee", fields: [franchiseeId], references: [id])
  users                  User[]                     @relation("FranchiseUsers")
  customerRequests       FranchiseCustomerRequest[]
  incentiveRates         FranchiseIncentiveRate[]
  incentiveEntries       IncentiveEntry[]
  incentivePayoutBatches IncentivePayoutBatch[]
  tickets                SupportTicket[]

  @@index([franchiseeId])
  @@index([createdById])
  @@index([isActive])
  @@index([deletedAt])
  @@map("franchises")
}

// A franchisee-submitted request to onboard a new customer. Franchisees
// cannot create customers directly — an admin must approve the request,
// which then creates the actual User (CLIENT, RETAIL, attached to the
// requesting franchise).
model FranchiseCustomerRequest {
  id                  String        @id @default(cuid())
  franchiseId         String
  franchise           Franchise     @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  requestedById       String
  requestedBy         User          @relation("CustomerRequestsSubmitted", fields: [requestedById], references: [id])
  name                String
  email               String
  phoneNumber         String?
  luxorSubaccountName String?
  initialDeposit      Decimal?      @db.Decimal(12, 2)
  status              RequestStatus @default(PENDING)
  rejectionReason     String?
  reviewedById        String?
  reviewedBy          User?         @relation("CustomerRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  createdUserId       String?       @unique
  createdUser         User?         @relation("CustomerRequestsCreatedUser", fields: [createdUserId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([franchiseId])
  @@index([status])
  @@index([requestedById])
  @@map("franchise_customer_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A client-submitted request to change the payout wallet address on their
// Luxor subaccount. currentAddress snapshots the live Luxor address at
// request time so the request row itself is a permanent audit record of
// what the address was and what it changed to - no separate history table.
// On approval, the address is pushed to Luxor directly (see
// /api/wallet/change-requests/[id]/approve) and appliedAt is stamped.
// Braiins is out of scope: braiins.ts has no equivalent "configured payout
// address" API to read or write against.
model WalletChangeRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("walletChangeRequests", fields: [userId], references: [id])
  currency         String        @default("BTC")
  currentAddress   String?
  requestedAddress String
  reason           String?       @db.Text
  status           RequestStatus @default(PENDING)
  rejectionReason  String?
  reviewedById     String?
  reviewedBy       User?         @relation("walletChangeRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  appliedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("wallet_change_requests")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@map("token_blacklist")
}

model WebAuthnCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId Bytes @unique
  publicKey    Bytes
  counter      Int   @default(0)

  transports String[] @default([])
  aaguid     String?

  credentialName String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_activities")
}

model UserSession {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  loginAt   DateTime   @default(now())
  logoutAt  DateTime?
  duration  Int?
  ipAddress String?
  userAgent String?
  tabVisits TabVisit[]
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model TabVisit {
  id        String      @id @default(cuid())
  sessionId String
  session   UserSession @relation(fields: [sessionId], references: [id])
  userId    String
  tabKey    String
  tabName   String
  visitedAt DateTime    @default(now())

  @@index([sessionId])
  @@index([userId])
  @@map("tab_visits")
}

enum PaybackProfileType {
  CLIENT
  COMPANY
}

model PaybackConfig {
  id                           Int                @id @default(autoincrement())
  profileType                  PaybackProfileType @default(CLIENT)
  s21proHostingCharges         Decimal            @db.Decimal(10, 5)
  s21xpHostingCharges          Decimal            @db.Decimal(10, 5)
  s21proMonthlyInvoicingAmount Decimal            @db.Decimal(12, 2)
  s21xpMonthlyInvoicingAmount  Decimal            @db.Decimal(12, 2)
  s21proPowerConsumption       Decimal            @db.Decimal(10, 4)
  s21xpPowerConsumption        Decimal            @db.Decimal(10, 4)
  s21proMachineCost            Decimal            @db.Decimal(12, 2)
  s21xpMachineCost             Decimal            @db.Decimal(12, 2)
  poolCommissionStockOs        Decimal            @db.Decimal(5, 2)
  poolCommissionLuxos          Decimal            @default(2.50) @db.Decimal(5, 2)
  s21proHashrateStockOs        Decimal            @db.Decimal(10, 2)
  s21proHashrateLuxos          Decimal            @db.Decimal(10, 2)
  s21xpHashrateStockOs         Decimal            @db.Decimal(10, 2)
  s21xpHashrateLuxos           Decimal            @db.Decimal(10, 2)
  breakevenBtcPrice            Decimal            @default(63500) @db.Decimal(12, 2)
  defaultInvoicedAmount        Decimal            @default(4250) @db.Decimal(12, 2)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  @@unique([profileType])
  @@map("payback_config")
}

model PaybackDailySnapshot {
  id                           Int      @id @default(autoincrement())
  date                         DateTime @unique @db.Date
  btcCloseUsd                  Decimal  @db.Decimal(12, 2)
  hashpriceBtcPerPhDay         Decimal  @db.Decimal(20, 10)
  clientS21ProStockBreakeven   Decimal  @db.Decimal(12, 2)
  clientS21ProCustomBreakeven  Decimal  @db.Decimal(12, 2)
  clientS21XpStockBreakeven    Decimal  @db.Decimal(12, 2)
  clientS21XpCustomBreakeven   Decimal  @db.Decimal(12, 2)
  companyS21ProStockBreakeven  Decimal  @db.Decimal(12, 2)
  companyS21ProCustomBreakeven Decimal  @db.Decimal(12, 2)
  companyS21XpStockBreakeven   Decimal  @db.Decimal(12, 2)
  companyS21XpCustomBreakeven  Decimal  @db.Decimal(12, 2)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("payback_daily_snapshot")
}

model Hardware {
  id                 String                       @id @default(cuid())
  model              String                       @unique
  powerUsage         Float
  hashRate           Decimal
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  quantity           Int                          @default(1)
  isDeleted          Boolean                      @default(false)
  procurementHistory HardwareProcurementHistory[]
  miners             Miner[]
  invoices           Invoice[]
  invoiceLineItems   InvoiceLineItem[]

  @@index([isDeleted])
  @@map("hardware")
}

model Miner {
  id               String                  @id @default(cuid())
  name             String
  status           String                  @default("DEPLOYMENT_IN_PROGRESS")
  userId           String
  spaceId          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  hardwareId       String
  isDeleted        Boolean                 @default(false)
  poolId           String?
  poolAuth         String?
  serialNumber     String?
  macAddress       String?
  ownershipHistory MinerOwnershipHistory[]
  rateHistory      MinerRateHistory[]
  poolHistory      MinerPoolHistory[]
  hardware         Hardware                @relation(fields: [hardwareId], references: [id])
  space            Space                   @relation(fields: [spaceId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])
  pool             Pool?                   @relation(fields: [poolId], references: [id])
  repairNotes      MinerRepairNote[]       @relation("MinerRepairNotes")
  tickets          SupportTicket[]

  @@unique([name, userId])
  @@index([hardwareId])
  @@index([isDeleted])
  @@index([poolId])
  @@map("miners")
}

model MinerRateHistory {
  id           String   @id @default(cuid())
  minerId      String
  rate_per_kwh Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())
  miner        Miner    @relation(fields: [minerId], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([minerId, createdAt(sort: Desc)])
  @@map("miner_rate_history")
}

model Space {
  id            String   @id @default(cuid())
  name          String
  location      String
  address       String?
  capacity      Int
  powerCapacity Float
  status        String   @default("AVAILABLE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  miners        Miner[]

  @@map("spaces")
}

model Pool {
  id          String   @id @default(cuid())
  name        String   @unique
  apiUrl      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  miners          Miner[]
  poolAuths       PoolAuth[]
  poolHistory     MinerPoolHistory[]
  poolSubaccounts PoolSubaccount[]
  transactions    PoolTransaction[]

  @@map("pools")
}

model PoolAuth {
  id        String   @id @default(cuid())
  poolId    String
  userId    String
  authKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pool             Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSubaccounts GroupSubaccount[]
  poolSubaccounts  PoolSubaccount[]

  @@unique([poolId, userId])
  @@index([userId])
  @@index([poolId])
  @@map("pool_auths")
}

// ============================================================================
// Pool historical data (Luxor / Braiins) — captured on our own cadence so we
// stop depending on the pools' retention and reduce live API calls.
//
// PoolSubaccount is the dimension row: one per (pool, subaccountName). userId
// is nullable because not every subaccount is tied to a client yet —
// GroupSubaccount rows can be credential-based with no user, and some
// subaccounts (e.g. a company-wide one used for pool-wide hashprice) are
// never linked to a User at all.
//
// PoolSubaccountDailySnapshot / PoolWorkerDailyMetric are daily rollups, not
// raw pool ticks (5m/1h) — matches the existing PaybackDailySnapshot pattern.
// PoolTransaction is the raw ledger, kept separately since it's a different
// shape/cadence (one row per pool-side transaction, not per day).
// ============================================================================

model PoolSubaccount {
  id               String    @id @default(cuid())
  poolId           String
  subaccountName   String
  userId           String?
  poolAuthId       String?
  currency         String    @default("BTC")
  walletAddress    String?
  paymentFrequency String?
  dayOfWeek        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pool           Pool                          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user           User?                         @relation(fields: [userId], references: [id])
  poolAuth       PoolAuth?                     @relation(fields: [poolAuthId], references: [id])
  dailySnapshots PoolSubaccountDailySnapshot[]
  workerMetrics  PoolWorkerDailyMetric[]
  transactions   PoolTransaction[]

  @@unique([poolId, subaccountName])
  @@index([userId])
  @@index([poolAuthId])
  @@map("pool_subaccounts")
}

model PoolSubaccountDailySnapshot {
  id               String   @id @default(cuid())
  poolSubaccountId String
  date             DateTime @db.Date

  hashrate      Decimal? // H/s, 24h average
  efficiency    Decimal? // percent 0-100; null if the pool doesn't report it (Braiins)
  uptime        Decimal? // percent 0-100; null if the pool doesn't report it (Braiins)
  activeWorkers Int?
  hashprice     Decimal?
  balance       Decimal? @db.Decimal(20, 8)

  miningRevenue   Decimal @default(0) @db.Decimal(20, 8)
  referralRevenue Decimal @default(0) @db.Decimal(20, 8)
  otherRevenue    Decimal @default(0) @db.Decimal(20, 8)
  totalRevenue    Decimal @default(0) @db.Decimal(20, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poolSubaccount PoolSubaccount @relation(fields: [poolSubaccountId], references: [id], onDelete: Cascade)

  @@unique([poolSubaccountId, date])
  @@index([date])
  @@map("pool_subaccount_daily_snapshots")
}

model PoolWorkerDailyMetric {
  id               String   @id @default(cuid())
  poolSubaccountId String
  // Identity key. Braiins workers have no stable ID, only a name, so a
  // rename reads as a new worker here — a known limitation of the source
  // data, not something we can resolve on our side.
  workerName       String
  externalWorkerId String? // Luxor's worker id, when available
  date             DateTime @db.Date

  hashrate       Decimal?
  efficiency     Decimal?
  staleShares    Int?
  rejectedShares Int?
  estRevenue     Decimal? @db.Decimal(20, 8)
  firmware       String?
  status         String? // normalized ACTIVE/INACTIVE

  createdAt DateTime @default(now())

  poolSubaccount PoolSubaccount @relation(fields: [poolSubaccountId], references: [id], onDelete: Cascade)

  @@unique([poolSubaccountId, workerName, date])
  @@index([date])
  @@map("pool_worker_daily_metrics")
}

model PoolTransaction {
  id                    String   @id @default(cuid())
  // externalTransactionId is nullable and NOT the dedupe key: Luxor leaves it
  // blank ("") on ~90% of rows (daily "Miner Revenue"/"LuxOS Rebate" accrual
  // credits) and only populates it for real on-chain movements (Payment,
  // Transaction Fee). Dedup instead on the composite key below.
  poolId                String
  poolSubaccountId      String
  externalTransactionId String?
  transactionType       String // credit / debit
  category              String? // Luxor transaction_category / Braiins payout kind
  amount                Decimal  @db.Decimal(20, 8)
  usdEquivalent         Decimal? @db.Decimal(20, 2)
  addressName           String?
  status                String? // Braiins payout status: queued/confirmed/failed
  occurredAt            DateTime

  createdAt DateTime @default(now())

  pool           Pool           @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolSubaccount PoolSubaccount @relation(fields: [poolSubaccountId], references: [id], onDelete: Cascade)

  @@unique([poolSubaccountId, occurredAt, category, transactionType, amount])
  @@index([poolId])
  @@index([externalTransactionId])
  @@index([occurredAt])
  @@map("pool_transactions")
}

model CostPayment {
  id          String      @id @default(cuid())
  userId      String
  invoiceId   String?
  memoId      String?
  amount      Float
  consumption Float
  type        PaymentType
  createdAt   DateTime    @default(now())
  narration   String?
  isDeleted   Boolean     @default(false)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice     Invoice?    @relation("invoiceCostPayments", fields: [invoiceId], references: [id], onDelete: Cascade)
  memo        Memo?       @relation(fields: [memoId], references: [id])

  @@index([userId])
  @@index([invoiceId])
  @@index([memoId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("cost_payments")
}

model MinerOwnershipHistory {
  id          String   @id @default(cuid())
  ownerId     String
  createdById String
  createdAt   DateTime @default(now())
  minerId     String?
  createdBy   User     @relation("createdBy", fields: [createdById], references: [id], onDelete: Cascade)
  miner       Miner?   @relation(fields: [minerId], references: [id], onDelete: Cascade)
  owner       User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([ownerId])
  @@index([createdById])
  @@map("miner_ownership_history")
}

model MinerPoolHistory {
  id          String   @id @default(cuid())
  minerId     String
  poolId      String
  createdById String
  createdAt   DateTime @default(now())

  miner     Miner @relation(fields: [minerId], references: [id], onDelete: Cascade)
  pool      Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  createdBy User  @relation("MinerPoolHistoryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([poolId])
  @@index([createdById])
  @@map("miner_pool_history")
}

model HardwareProcurementHistory {
  id          String   @id @default(cuid())
  hardwareId  String
  quantity    Int
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  hardware    Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@index([hardwareId])
  @@index([createdById])
  @@map("hardware_procurement_history")
}

model Group {
  id                  String            @id @default(cuid())
  name                String            @db.VarChar(255)
  relationshipManager String?           @db.VarChar(255)
  email               String?           @db.VarChar(255)
  description         String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String
  subaccounts         GroupSubaccount[]
  creator             User              @relation(fields: [createdBy], references: [id])

  @@index([isActive])
  @@map("groups")
}

model GroupSubaccount {
  id             String    @id @default(cuid())
  groupId        String
  // Null for members added without a Luxor subaccount (userId-based
  // membership) - still @unique since Postgres treats multiple NULLs as
  // distinct, so this doesn't collide across those rows.
  subaccountName String?   @unique
  poolAuthId     String?
  // Direct membership for CLIENT users with no Luxor subaccount/PoolAuth.
  // Mutually exclusive with poolAuthId in practice: a row is either
  // credential-based (poolAuthId set) or user-based (userId set).
  userId         String?
  addedAt        DateTime  @default(now())
  addedBy        String
  addedByUserId  String?
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  poolAuth       PoolAuth? @relation(fields: [poolAuthId], references: [id])
  user           User?     @relation("GroupSubaccountUser", fields: [userId], references: [id])
  addedByUser    User?     @relation("GroupSubaccountAddedBy", fields: [addedByUserId], references: [id])

  @@index([groupId])
  @@index([subaccountName])
  @@index([poolAuthId])
  @@index([userId])
  @@map("group_subaccounts")
}

model Invoice {
  id                     String                @id @default(cuid())
  invoiceNumber          String                @unique
  userId                 String
  hardwareId             String?
  totalMiners            Int
  unitPrice              Decimal               @db.Decimal(10, 2)
  totalAmount            Decimal               @db.Decimal(12, 2)
  status                 InvoiceStatus
  invoiceType            InvoiceType           @default(ELECTRICITY_CHARGES)
  invoiceGeneratedDate   DateTime
  issuedDate             DateTime?
  dueDate                DateTime
  billingMonth           DateTime? // Format: First day of month (e.g., 2026-04-01 for April 2026)
  machineHostingLocation String?
  paidDate               DateTime?
  createdBy              String
  updatedBy              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  notifications          InvoiceNotification[] @relation("invoiceNotifications")
  costPayments           CostPayment[]         @relation("invoiceCostPayments")
  tickets                SupportTicket[]
  confirmoPayment        ConfirmoPayment?
  emailSendResults       EmailSendResult[]     @relation("emailSendResults")
  lineItems              InvoiceLineItem[]
  memos                  Memo[]                @relation("invoiceMemos")
