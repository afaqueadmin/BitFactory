generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  name                       String?
  password                   String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  companyName                String?
  profileImage               String?
  profileImageId             String?
  city                       String?
  country                    String?
  dateOfBirth                DateTime?
  phoneNumber                String?
  streetAddress              String?
  twoFactorEnabled           Boolean                      @default(false)
  twoFactorSecret            String?
  twoFactorBackupCodes       String[]
  role                       Role                         @default(CLIENT)
  idNumber                   String?
  luxorSubaccountName        String?
  companyUrl                 String?
  isDeleted                  Boolean                      @default(false)
  franchiseeId               String?
  franchisee                 Franchise?                   @relation("FranchiseUsers", fields: [franchiseeId], references: [id])
  segment                    Segment?
  auditLogs                  AuditLog[]                   @relation("auditLogs")
  costPayments               CostPayment[]
  pricingCreated             CustomerPricingConfig[]      @relation("pricingConfigsCreated")
  pricingUpdated             CustomerPricingConfig[]      @relation("pricingConfigsUpdated")
  pricingConfigs             CustomerPricingConfig[]      @relation("pricingConfigs")
  createdGroups              Group[]
  franchisesOwned            Franchise[]                  @relation("FranchiseFranchisee")
  franchisesCreated          Franchise[]                  @relation("FranchiseCreatedBy")
  hardwareProcurementHistory HardwareProcurementHistory[]
  invoicesCreated            Invoice[]                    @relation("invoicesCreated")
  invoicesUpdated            Invoice[]                    @relation("invoicesUpdated")
  invoices                   Invoice[]                    @relation("invoices")
  vendorInvoicesCreated      VendorInvoice[]              @relation("vendorInvoicesCreated")
  vendorInvoicesUpdated      VendorInvoice[]              @relation("vendorInvoicesUpdated")
  hardwarePurchasesCreated   HardwarePurchaseInvoice[]    @relation("hardwarePurchasesCreated")
  hardwarePurchasesUpdated   HardwarePurchaseInvoice[]    @relation("hardwarePurchasesUpdated")
  createdMinerHistory        MinerOwnershipHistory[]      @relation("createdBy")
  ownedMinerHistory          MinerOwnershipHistory[]      @relation("owner")
  miners                     Miner[]
  emailSendRunsCreated       EmailSendRun[]               @relation("emailSendRunsCreated")
  emailSendResults           EmailSendResult[]            @relation("emailSendResults")
  recurringCreated           RecurringInvoice[]           @relation("recurringInvoicesCreated")
  recurringUpdated           RecurringInvoice[]           @relation("recurringInvoicesUpdated")
  recurringInvoices          RecurringInvoice[]           @relation("recurringInvoices")
  blacklisted                TokenBlacklist[]
  activities                 UserActivity[]
  sessions                   UserSession[]
  paymentDetailsUpdates      PaymentDetails[]
  poolAuths                  PoolAuth[]
  webauthnCredentials        WebAuthnCredential[]
  invoicedAmount             Decimal                      @db.Decimal(12, 2)
  createdRepairNotes         MinerRepairNote[]            @relation("CreatedRepairNotes")
  createdMinerPoolHistory    MinerPoolHistory[]           @relation("MinerPoolHistoryCreatedBy")
  addedGroupSubaccounts      GroupSubaccount[]            @relation("GroupSubaccountAddedBy")
  customerRequestsSubmitted  FranchiseCustomerRequest[]   @relation("CustomerRequestsSubmitted")
  customerRequestsReviewed   FranchiseCustomerRequest[]   @relation("CustomerRequestsReviewed")
  customerRequestCreatedFrom FranchiseCustomerRequest?    @relation("CustomerRequestsCreatedUser")
  incentiveRatesCreated      FranchiseIncentiveRate[]     @relation("incentiveRatesCreated")
  incentiveRatesUpdated      FranchiseIncentiveRate[]     @relation("incentiveRatesUpdated")
  incentiveEntriesAsClient   IncentiveEntry[]             @relation("incentiveEntriesClient")
  incentivePayoutsCreated    IncentivePayoutBatch[]       @relation("incentivePayoutsCreated")

  @@index([isDeleted])
  @@index([franchiseeId])
  @@index([segment])
  @@map("users")
}

model Franchise {
  id                   String    @id @default(cuid())
  businessName         String
  authorizedPersonName String
  email                String
  phoneNumber          String
  address              String
  city                 String
  state                String
  postalCode           String
  franchiseCode        String    @unique
  createdById          String
  createdBy            User      @relation("FranchiseCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  franchiseeId         String
  franchisee           User      @relation("FranchiseFranchisee", fields: [franchiseeId], references: [id])
  users                User[]    @relation("FranchiseUsers")
  customerRequests     FranchiseCustomerRequest[]
  incentiveRates          FranchiseIncentiveRate[]
  incentiveEntries        IncentiveEntry[]
  incentivePayoutBatches  IncentivePayoutBatch[]

  @@index([franchiseeId])
  @@index([createdById])
  @@index([isActive])
  @@index([deletedAt])
  @@map("franchises")
}

// A franchisee-submitted request to onboard a new customer. Franchisees
// cannot create customers directly — an admin must approve the request,
// which then creates the actual User (CLIENT, RETAIL, attached to the
// requesting franchise).
model FranchiseCustomerRequest {
  id                  String        @id @default(cuid())
  franchiseId         String
  franchise           Franchise     @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  requestedById       String
  requestedBy         User          @relation("CustomerRequestsSubmitted", fields: [requestedById], references: [id])
  name                String
  email               String
  phoneNumber         String?
  luxorSubaccountName String?
  initialDeposit      Decimal?      @db.Decimal(12, 2)
  status              RequestStatus @default(PENDING)
  rejectionReason     String?
  reviewedById        String?
  reviewedBy          User?         @relation("CustomerRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  createdUserId       String?       @unique
  createdUser         User?         @relation("CustomerRequestsCreatedUser", fields: [createdUserId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([franchiseId])
  @@index([status])
  @@index([requestedById])
  @@map("franchise_customer_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@map("token_blacklist")
}

model WebAuthnCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId Bytes @unique
  publicKey    Bytes
  counter      Int   @default(0)

  transports String[] @default([])
  aaguid     String?

  credentialName String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_activities")
}

model UserSession {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  loginAt   DateTime   @default(now())
  logoutAt  DateTime?
  duration  Int?
  ipAddress String?
  userAgent String?
  tabVisits TabVisit[]
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model TabVisit {
  id        String      @id @default(cuid())
  sessionId String
  session   UserSession @relation(fields: [sessionId], references: [id])
  userId    String
  tabKey    String
  tabName   String
  visitedAt DateTime    @default(now())

  @@index([sessionId])
  @@index([userId])
  @@map("tab_visits")
}

enum PaybackProfileType {
  CLIENT
  COMPANY
}

model PaybackConfig {
  id                     Int                @id @default(autoincrement())
  profileType            PaybackProfileType @default(CLIENT)
  hostingCharges         Decimal            @db.Decimal(10, 5)
  monthlyInvoicingAmount Decimal            @db.Decimal(12, 2)
  powerConsumption       Decimal            @db.Decimal(10, 4)
  s21proMachineCost      Decimal            @db.Decimal(12, 2)
  s21xpMachineCost       Decimal            @db.Decimal(12, 2)
  poolCommissionStockOs  Decimal            @db.Decimal(5, 2)
  poolCommissionLuxos    Decimal            @default(2.50) @db.Decimal(5, 2)
  s21proHashrateStockOs  Decimal            @db.Decimal(10, 2)
  s21proHashrateLuxos    Decimal            @db.Decimal(10, 2)
  s21xpHashrateStockOs   Decimal            @db.Decimal(10, 2)
  s21xpHashrateLuxos     Decimal            @db.Decimal(10, 2)
  breakevenBtcPrice      Decimal            @default(63500) @db.Decimal(12, 2)
  defaultInvoicedAmount  Decimal            @default(4250) @db.Decimal(12, 2)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([profileType])
  @@map("payback_config")
}

model PaybackDailySnapshot {
  id                            Int      @id @default(autoincrement())
  date                          DateTime @unique @db.Date
  btcCloseUsd                   Decimal  @db.Decimal(12, 2)
  hashpriceBtcPerPhDay           Decimal @db.Decimal(20, 10)
  clientS21ProStockBreakeven    Decimal  @db.Decimal(12, 2)
  clientS21ProCustomBreakeven   Decimal  @db.Decimal(12, 2)
  clientS21XpStockBreakeven     Decimal  @db.Decimal(12, 2)
  clientS21XpCustomBreakeven    Decimal  @db.Decimal(12, 2)
  companyS21ProStockBreakeven   Decimal  @db.Decimal(12, 2)
  companyS21ProCustomBreakeven  Decimal  @db.Decimal(12, 2)
  companyS21XpStockBreakeven    Decimal  @db.Decimal(12, 2)
  companyS21XpCustomBreakeven   Decimal  @db.Decimal(12, 2)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("payback_daily_snapshot")
}

model Hardware {
  id                 String                       @id @default(cuid())
  model              String                       @unique
  powerUsage         Float
  hashRate           Decimal
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  quantity           Int                          @default(1)
  isDeleted          Boolean                      @default(false)
  procurementHistory HardwareProcurementHistory[]
  miners             Miner[]
  invoices           Invoice[]
  invoiceLineItems   InvoiceLineItem[]

  @@index([isDeleted])
  @@map("hardware")
}

model Miner {
  id               String                  @id @default(cuid())
  name             String
  status           String                  @default("DEPLOYMENT_IN_PROGRESS")
  userId           String
  spaceId          String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  hardwareId       String
  isDeleted        Boolean                 @default(false)
  poolId           String?
  poolAuth         String?
  serialNumber     String?
  macAddress       String?
  ownershipHistory MinerOwnershipHistory[]
  rateHistory      MinerRateHistory[]
  poolHistory      MinerPoolHistory[]
  hardware         Hardware                @relation(fields: [hardwareId], references: [id])
  space            Space                   @relation(fields: [spaceId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])
  pool             Pool?                   @relation(fields: [poolId], references: [id])
  repairNotes      MinerRepairNote[]       @relation("MinerRepairNotes")

  @@unique([name, userId])
  @@index([hardwareId])
  @@index([isDeleted])
  @@index([poolId])
  @@map("miners")
}

model MinerRateHistory {
  id           String   @id @default(cuid())
  minerId      String
  rate_per_kwh Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())
  miner        Miner    @relation(fields: [minerId], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([minerId, createdAt(sort: Desc)])
  @@map("miner_rate_history")
}

model Space {
  id            String   @id @default(cuid())
  name          String
  location      String
  address       String?
  capacity      Int
  powerCapacity Float
  status        String   @default("AVAILABLE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  miners        Miner[]

  @@map("spaces")
}

model Pool {
  id          String   @id @default(cuid())
  name        String   @unique
  apiUrl      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  miners      Miner[]
  poolAuths   PoolAuth[]
  poolHistory MinerPoolHistory[]

  @@map("pools")
}

model PoolAuth {
  id        String   @id @default(cuid())
  poolId    String
  userId    String
  authKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pool             Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSubaccounts GroupSubaccount[]

  @@unique([poolId, userId])
  @@index([userId])
  @@index([poolId])
  @@map("pool_auths")
}

model CostPayment {
  id          String      @id @default(cuid())
  userId      String
  invoiceId   String?
  amount      Float
  consumption Float
  type        PaymentType
  createdAt   DateTime    @default(now())
  narration   String?
  isDeleted   Boolean     @default(false)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice     Invoice?    @relation("invoiceCostPayments", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("cost_payments")
}

model MinerOwnershipHistory {
  id          String   @id @default(cuid())
  ownerId     String
  createdById String
  createdAt   DateTime @default(now())
  minerId     String?
  createdBy   User     @relation("createdBy", fields: [createdById], references: [id], onDelete: Cascade)
  miner       Miner?   @relation(fields: [minerId], references: [id], onDelete: Cascade)
  owner       User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([ownerId])
  @@index([createdById])
  @@map("miner_ownership_history")
}

model MinerPoolHistory {
  id          String   @id @default(cuid())
  minerId     String
  poolId      String
  createdById String
  createdAt   DateTime @default(now())

  miner     Miner @relation(fields: [minerId], references: [id], onDelete: Cascade)
  pool      Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  createdBy User  @relation("MinerPoolHistoryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([poolId])
  @@index([createdById])
  @@map("miner_pool_history")
}

model HardwareProcurementHistory {
  id          String   @id @default(cuid())
  hardwareId  String
  quantity    Int
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  hardware    Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@index([hardwareId])
  @@index([createdById])
  @@map("hardware_procurement_history")
}

model Group {
  id                  String            @id @default(cuid())
  name                String            @db.VarChar(255)
  relationshipManager String?           @db.VarChar(255)
  email               String?           @db.VarChar(255)
  description         String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String
  subaccounts         GroupSubaccount[]
  creator             User              @relation(fields: [createdBy], references: [id])

  @@index([isActive])
  @@map("groups")
}

model GroupSubaccount {
  id             String    @id @default(cuid())
  groupId        String
  subaccountName String    @unique
  poolAuthId     String?
  addedAt        DateTime  @default(now())
  addedBy        String
  addedByUserId  String?
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  poolAuth       PoolAuth? @relation(fields: [poolAuthId], references: [id])
  addedByUser    User?     @relation("GroupSubaccountAddedBy", fields: [addedByUserId], references: [id])

  @@index([groupId])
  @@index([subaccountName])
  @@index([poolAuthId])
  @@map("group_subaccounts")
}

model Invoice {
  id                   String                @id @default(cuid())
  invoiceNumber        String                @unique
  userId               String
  hardwareId           String?
  totalMiners          Int
  unitPrice            Decimal               @db.Decimal(10, 2)
  totalAmount          Decimal               @db.Decimal(12, 2)
  status               InvoiceStatus
  invoiceType          InvoiceType           @default(ELECTRICITY_CHARGES)
  invoiceGeneratedDate DateTime
  issuedDate           DateTime?
  dueDate              DateTime
  billingMonth         DateTime? // Format: First day of month (e.g., 2026-04-01 for April 2026)
  machineHostingLocation String?
  paidDate             DateTime?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  notifications        InvoiceNotification[] @relation("invoiceNotifications")
  costPayments         CostPayment[]         @relation("invoiceCostPayments")
  confirmoPayment      ConfirmoPayment?
  emailSendResults     EmailSendResult[]     @relation("emailSendResults")
  lineItems            InvoiceLineItem[]
  createdByUser        User                  @relation("invoicesCreated", fields: [createdBy], references: [id])
  updatedByUser        User?                 @relation("invoicesUpdated", fields: [updatedBy], references: [id])
  user                 User                  @relation("invoices", fields: [userId], references: [id])
  hardware             Hardware?             @relation(fields: [hardwareId], references: [id])
  incentiveEntries     IncentiveEntry[]      @relation("invoiceIncentiveEntries")

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceLineItem {
  id         String   @id @default(cuid())
  invoiceId  String
  hardwareId String?
  model      String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hardware Hardware? @relation(fields: [hardwareId], references: [id])

  @@index([invoiceId])
  @@index([hardwareId])
  @@map("invoice_line_items")
}

model VendorInvoice {
  id                   String              @id @default(cuid())
  invoiceNumber        String              @unique
  billingDate          DateTime            @db.Date
  paidDate             DateTime?
  dueDate              DateTime
  totalMiners          Int
  isDeleted            Boolean             @default(false)
  unitPrice            Decimal             @db.Decimal(10, 2)
  miscellaneousCharges Decimal             @default(0.00) @db.Decimal(10, 2)
  totalAmount          Decimal             @db.Decimal(12, 2)
  paymentStatus        VendorPaymentStatus @default(Pending)
  notes                String?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdByUser        User                @relation("vendorInvoicesCreated", fields: [createdBy], references: [id])
  updatedByUser        User?               @relation("vendorInvoicesUpdated", fields: [updatedBy], references: [id])

  @@index([paymentStatus])
  @@index([billingDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("vendor_invoices")
}

model HardwarePurchaseInvoice {
  id                   String              @id @default(cuid())
  invoiceNumber        String              @unique
  vendorName           String
  hardwareDescription  String
  billingDate          DateTime            @db.Date
  paidDate             DateTime?
  dueDate              DateTime
  quantity             Int
  isDeleted            Boolean             @default(false)
  unitPrice            Decimal             @db.Decimal(10, 2)
  miscellaneousCharges Decimal             @default(0.00) @db.Decimal(10, 2)
  totalAmount          Decimal             @db.Decimal(12, 2)
  paymentStatus        VendorPaymentStatus @default(Pending)
  notes                String?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdByUser        User                @relation("hardwarePurchasesCreated", fields: [createdBy], references: [id])
  updatedByUser        User?               @relation("hardwarePurchasesUpdated", fields: [updatedBy], references: [id])

  @@index([paymentStatus])
  @@index([billingDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("hardware_purchase_invoices")
}

model RecurringInvoice {
  id                String    @id @default(cuid())
  userId            String
  dayOfMonth        Int
  unitPrice         Decimal   @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime?
  isActive          Boolean   @default(true)
  lastGeneratedDate DateTime?
  createdBy         String
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdByUser     User      @relation("recurringInvoicesCreated", fields: [createdBy], references: [id])
  updatedByUser     User?     @relation("recurringInvoicesUpdated", fields: [updatedBy], references: [id])
  user              User      @relation("recurringInvoices", fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@index([dayOfMonth])
  @@index([startDate])
  @@map("recurring_invoices")
}

model CustomerPricingConfig {
  id               String    @id @default(cuid())
  userId           String
  defaultUnitPrice Decimal   @db.Decimal(10, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdByUser    User      @relation("pricingConfigsCreated", fields: [createdBy], references: [id])
  updatedByUser    User?     @relation("pricingConfigsUpdated", fields: [updatedBy], references: [id])
  user             User      @relation("pricingConfigs", fields: [userId], references: [id])

  @@unique([userId, effectiveFrom])
  @@index([userId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("customer_pricing_config")
}

// Per-franchise, effective-dated incentive rate configuration. One row per
// (franchise, incentiveType, effectiveFrom) — never mutated in place, only
// superseded by a new row (mirrors CustomerPricingConfig) so that amounts
// already snapshotted onto IncentiveEntry rows never drift.
model FranchiseIncentiveRate {
  id            String              @id @default(cuid())
  franchiseId   String
  incentiveType IncentiveType
  rateBasis     IncentiveRateBasis? // HARDWARE_SALE only: which of flatAmount/percentage applies
  flatAmount    Decimal?            @db.Decimal(12, 2) // $/unit (HARDWARE_SALE flat) or $/machine/month (OWN_MACHINE_HOSTING_REBATE)
  percentage    Decimal?            @db.Decimal(5, 2) // HARDWARE_SALE percent, or CLIENT_HOSTING_COMMISSION
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String
  updatedBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  franchise     Franchise           @relation(fields: [franchiseId], references: [id])
  createdByUser User                @relation("incentiveRatesCreated", fields: [createdBy], references: [id])
  updatedByUser User?               @relation("incentiveRatesUpdated", fields: [updatedBy], references: [id])
  entries       IncentiveEntry[]

  @@unique([franchiseId, incentiveType, effectiveFrom])
  @@index([franchiseId])
  @@index([incentiveType])
  @@index([effectiveTo])
  @@map("franchise_incentive_rates")
}

// Individual accrued (or reversed / clawback) incentive amounts. Created by
// src/lib/incentives/accrue.ts when a source invoice is issued, reversed by
// src/lib/incentives/reverse.ts if that invoice is later cancelled/refunded.
model IncentiveEntry {
  id                  String                  @id @default(cuid())
  franchiseId         String
  incentiveType       IncentiveType
  rateId              String?
  sourceInvoiceId     String? // null for clawback/adjustment rows
  sourceInvoiceNumber String // snapshot, survives source invoice deletion
  clientUserId        String?
  basisAmount         Decimal                 @db.Decimal(12, 2) // invoice totalAmount or unit count the rate applied to
  rateApplied         Decimal                 @db.Decimal(12, 4) // snapshot of the % or flat rate actually used
  amount              Decimal                 @db.Decimal(12, 2) // computed incentive; negative for clawback rows
  status              IncentiveEntryStatus    @default(ACCRUED)
  accrualDate         DateTime                @default(now())
  billingPeriod       DateTime? // = source invoice's billingMonth, for reporting
  reversedAt          DateTime?
  reversedReason      String?
  adjustsEntryId      String? // set on a clawback row, points at the already-paid entry it offsets
  payoutBatchId       String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  franchise           Franchise               @relation(fields: [franchiseId], references: [id])
  rate                FranchiseIncentiveRate? @relation(fields: [rateId], references: [id])
  sourceInvoice       Invoice?                @relation("invoiceIncentiveEntries", fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  clientUser          User?                   @relation("incentiveEntriesClient", fields: [clientUserId], references: [id])
  adjustsEntry        IncentiveEntry?         @relation("entryAdjustments", fields: [adjustsEntryId], references: [id])
  adjustments         IncentiveEntry[]        @relation("entryAdjustments")
  payoutBatch         IncentivePayoutBatch?   @relation(fields: [payoutBatchId], references: [id])

  @@unique([sourceInvoiceId, incentiveType])
  @@index([franchiseId])
  @@index([status])
  @@index([payoutBatchId])
  @@index([incentiveType])
  @@index([accrualDate])
  @@map("incentive_entries")
}

// A batch payout event: admin marking one or more IncentiveEntry rows as
// paid to a franchisee, either individually (few entryIds) or in bulk
// (a full period's worth of outstanding entries) via the same endpoint.
model IncentivePayoutBatch {
  id            String           @id @default(cuid())
  franchiseId   String
  periodFrom    DateTime?
  periodTo      DateTime?
  totalAmount   Decimal          @db.Decimal(12, 2)
  entryCount    Int
  paidDate      DateTime
  notes         String?
  createdBy     String
  createdAt     DateTime         @default(now())
  franchise     Franchise        @relation(fields: [franchiseId], references: [id])
  createdByUser User             @relation("incentivePayoutsCreated", fields: [createdBy], references: [id])
  entries       IncentiveEntry[]

  @@index([franchiseId])
  @@index([paidDate])
  @@map("incentive_payout_batches")
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  userId      String
  changes     Json?
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User        @relation("auditLogs", fields: [userId], references: [id])

  @@index([entityId])
  @@index([entityType])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model InvoiceNotification {
  id               String             @id @default(cuid())
  invoiceId        String
  notificationType NotificationType
  sentTo           String
  ccEmails         String?
  sentAt           DateTime
  isRead           Boolean            @default(false)
  openedAt         DateTime?
  status           NotificationStatus
  failureReason    String?
  retryCount       Int                @default(0)
  nextRetryAt      DateTime?
  createdAt        DateTime           @default(now())
  invoice          Invoice            @relation("invoiceNotifications", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@index([sentTo])
  @@index([createdAt])
  @@index([sentAt])
  @@map("invoice_notifications")
}

