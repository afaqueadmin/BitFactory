// ============================================================================
// Miner hashrate benchmark alerting.
//
// MinerHashrateBenchmark is a history table (mirrors MinerRateHistory): the
// latest row per miner (by createdAt) is the active benchmark, in TH/s to
// match Hardware.hashRate and the rest of the admin UI's convention — the
// pool tables (PoolWorkerDailyMetric.hashrate) are in H/s and must be
// converted before comparing.
//
// MinerHashrateAlertLog records which (miner, date) pairs have already been
// notified, so the alert cron (which re-scans a rolling window each run,
// since it does not run inside cron_pool_worker_transactions and can't rely
// on "just wrote this row") never sends a duplicate email for the same day.
// ============================================================================

model MinerHashrateBenchmark {
  id                String   @id @default(cuid())
  minerId           String
  benchmarkHashrate Decimal  @db.Decimal(10, 2) // TH/s
  createdAt         DateTime @default(now())
  createdById       String

  miner     Miner @relation(fields: [minerId], references: [id], onDelete: Cascade)
  createdBy User  @relation("MinerHashrateBenchmarkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([minerId, createdAt(sort: Desc)])
  @@map("miner_hashrate_benchmarks")
}

model MinerHashrateAlertLog {
  id                String    @id @default(cuid())
  minerId           String
  date              DateTime  @db.Date
  actualHashrate    Decimal   @db.Decimal(10, 2) // TH/s, converted from PoolWorkerDailyMetric.hashrate (H/s)
  benchmarkHashrate Decimal   @db.Decimal(10, 2) // TH/s, the benchmark that was in effect when this alert fired
  notifiedAt        DateTime  @default(now())
  acknowledgedAt    DateTime?
  acknowledgedById  String?

  miner          Miner          @relation(fields: [minerId], references: [id], onDelete: Cascade)
  acknowledgedBy User?          @relation("MinerHashrateAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  restarts       MinerRestart[]

  @@unique([minerId, date])
  @@index([minerId])
  @@index([acknowledgedAt])
  @@map("miner_hashrate_alert_logs")
}

// A restart an admin performed on the miner from the Luxor backend (outside
// this app) and recorded here - nothing is sent to Luxor. Append-only history,
// like MinerRateHistory. restartedAt is the admin-entered time of the restart
// itself; createdAt is when it was recorded. alertId is set when it was
// recorded from a hashrate alert row, to show which alert it responded to.
model MinerRestart {
  id          String   @id @default(cuid())
  minerId     String
  alertId     String?
  restartedAt DateTime
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  miner     Miner                  @relation(fields: [minerId], references: [id], onDelete: Cascade)
  alert     MinerHashrateAlertLog? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  createdBy User                   @relation("MinerRestartCreatedBy", fields: [createdById], references: [id])

  @@index([minerId, restartedAt(sort: Desc)])
  @@index([alertId])
  @@index([createdById])
  @@map("miner_restarts")
}

model HardwareProcurementHistory {
  id          String   @id @default(cuid())
  hardwareId  String
  quantity    Int
