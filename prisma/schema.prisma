  type          String            @default("INVOICE_BULK_EMAIL")
  status        EmailRunStatus    @default(IN_PROGRESS)
  // What was emailed (invoice PDF vs cancellation notice) and how it was
  // triggered (bulk Issue & Send vs a single invoice action).
  kind          EmailRunKind      @default(INVOICE)
  source        EmailRunSource    @default(BULK)
  totalInvoices Int
  successCount  Int               @default(0)
  failureCount  Int               @default(0)
  createdBy     String
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  results       EmailSendResult[]
  creator       User              @relation("emailSendRunsCreated", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([createdBy])
  @@index([type])
  @@map("email_send_runs")
}

model EmailSendResult {
  id             String       @id @default(cuid())
  runId          String
  // Exactly one document per result: an invoice, or a memo. A memo whose
  // create email failed was rolled back, so neither id is set and only
  // documentNumber identifies it.
  invoiceId      String?
  memoId         String?
  documentNumber String?
  customerId     String
  customerName   String
  customerEmail  String
  ccEmails       String?
  success        Boolean
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  run            EmailSendRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  invoice        Invoice?     @relation("emailSendResults", fields: [invoiceId], references: [id], onDelete: SetNull)
  memo           Memo?        @relation("emailSendResults", fields: [memoId], references: [id], onDelete: SetNull)
  customer       User         @relation("emailSendResults", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([invoiceId])
  @@index([memoId])
  @@index([customerId])
  @@index([success])
  @@index([createdAt])
  @@map("email_send_results")
}

enum EmailRunStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum EmailRunKind {
  INVOICE
  CANCELLATION
  MEMO
  MEMO_VOID
}

enum EmailRunSource {
  BULK
  SINGLE
}

model ExternalResource {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("external_resources")
}

model MinerRepairNote {
  id          String   @id @default(cuid())
  minerId     String
  note        String   @db.Text
  dateOfEntry DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Set when the note was written by a Hardware Repair invoice; the note is
  // kept in sync with that invoice and deleted with it.
  invoiceId   String?  @unique

  miner     Miner    @relation("MinerRepairNotes", fields: [minerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CreatedRepairNotes", fields: [createdById], references: [id])
  invoice   Invoice? @relation("invoiceRepairNote", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([minerId])
  @@index([createdById])
  @@map("miner_repair_notes")
}

// A support ticket raised by a CLIENT or FRANCHISEE (acting for their own
// mining account). When raisedBy belongs to a franchise, franchiseId is
// denormalized onto the ticket so both the franchisee (scoped to their own
// franchise) and admin (unscoped) can query the same rows - support is
// visible to both simultaneously, admin can act on any ticket at any time.
// Optional minerId pins the ticket to a specific ASIC for hardware/pool
// issues, giving admins instant context instead of asking which machine.
// Optional invoiceId does the same for billing disputes - pins to the
// specific invoice instead of asking which one. Optional onBehalfOfUserId
// is set when a FRANCHISEE raises a ticket for one of their own onboarded
// clients rather than for their own account - raisedById stays the actual
// person who submitted it (the franchisee), onBehalfOfUserId is the
// customer the ticket concerns, so both the franchisee and that customer
// can see it.
model SupportTicket {
  id               String          @id @default(cuid())
  raisedById       String
  raisedBy         User            @relation("ticketsRaised", fields: [raisedById], references: [id])
  onBehalfOfUserId String?
  onBehalfOf       User?           @relation("ticketsOnBehalfOf", fields: [onBehalfOfUserId], references: [id])
  franchiseId      String?
  franchise        Franchise?      @relation(fields: [franchiseId], references: [id])
  minerId          String?
  miner            Miner?          @relation(fields: [minerId], references: [id])
  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  subject          String
  category         TicketCategory
  priority         TicketPriority  @default(NORMAL)
  status           TicketStatus    @default(OPEN)
  assignedToId     String?
  assignedTo       User?           @relation("ticketsAssigned", fields: [assignedToId], references: [id])
  messages         TicketMessage[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  closedAt         DateTime?

  @@index([raisedById])
  @@index([onBehalfOfUserId])
  @@index([franchiseId])
  @@index([minerId])
  @@index([invoiceId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("support_tickets")
}

// A message in a ticket's thread. authorId is null for system-generated
// entries (e.g. a live pool telemetry snapshot attached at ticket creation)
// - those are always isInternal since there's no customer-authored content
// to show them. isInternal lets an ADMIN/FRANCHISEE leave a note (e.g.
// escalating to a facility technician) that the CLIENT never sees, without
// needing a second message type.
model TicketMessage {
  id                 String        @id @default(cuid())
  ticketId           String
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId           String?
  author             User?         @relation("ticketMessagesAuthored", fields: [authorId], references: [id])
  body               String        @db.Text
  isInternal         Boolean       @default(false)
  isSystemGenerated  Boolean       @default(false)
  metadata           Json?
  attachmentUrl      String?
  attachmentPublicId String?
  createdAt          DateTime      @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

enum TicketCategory {
  HARDWARE_MINER
  BILLING_INVOICE
  POOL_HASHRATE
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}
