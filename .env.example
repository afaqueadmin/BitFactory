# Environment variables template for BitFactory project
# Copy this file to .env and fill in your actual values

# Database Configuration
# For development, you can use the shared Neon database or create your own
DATABASE_URL="postgresql://your_username:your_password@your_host:5432/your_database?sslmode=require"

# Example with Neon (replace with your actual credentials):
# DATABASE_URL="postgresql://neondb_owner:your_password@your_neon_host.neon.tech/neondb?sslmode=require&channel_binding=require"

# Next.js Configuration (optional)
# NEXTAUTH_SECRET="your_secret_here"
# NEXTAUTH_URL="http://localhost:3000"

# Add these to your existing .env file

# Email Configuration
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_FROM=noreply@bitfactory.com
SMTP_USER=your-email@gmail.com
SMTP_SECURE=false
SMTP_PASSWORD=your-app-specific-password
EMAIL_SERVICE="your-email-service-provider-here" # e.g., "gmail", "mailgun", "smtp"


# Support and Invoices Email Configuration
CC_SUPPORT_EMAIL="you support email here"
CC_INVOICES_EMAIL="your invoices email here"


# Next.js public environment variables (accessible in the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CONFIRMO Configuration
CONFIRMO_WEBHOOK_SECRET="your-confirmo-webhook-secret-here"
CONFIRMO_API_KEY="your-confirmo-api-key-here"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name-here"
CLOUDINARY_API_KEY="your-cloudinary-api-key-here"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-here"

# Luxor Mining Pool API (used by hashprice/payback-history endpoints)
LUXOR_API_KEY="your-luxor-api-key-here"
LUXOR_FIXED_SITE_ID="your-luxor-fixed-site-id-here"

# Cron Job Secret (used for securing cron job endpoints)
CRON_SECRET="your-cron-secret-here"

# JWT Secret (used for signing and verifying JSON Web Tokens)
# REQUIRED - login and every authenticated request fail without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here"
JWT_ACCESS_TOKEN_SECRET="your-jwt-access-token-secret-here"
JWT_REFRESH_TOKEN_SECRET="your-jwt-refresh-token-secret-here"

# Two-Factor Authentication Configuration
TWO_FACTOR_ENABLED="true" # Set to "true" to enable two-factor authentication, "false" to disable

# Encrypts stored authenticator-app secrets (src/lib/auth/totpSecret.ts).
# REQUIRED - 2FA setup fails without it. Every environment that shares a
# database must use the SAME key, and losing it breaks every user's 2FA
# (backup codes still work), so keep a copy somewhere safe outside Vercel.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY="your-base64-32-byte-key-here"

# BTCPay Server (Pay with Bitcoin button on customer invoices)
# Client-side flag (NEXT_PUBLIC_): set to "true" to show the button. Requires a rebuild/restart to change.
NEXT_PUBLIC_BTCPAY_ENABLED="false"

# Content-Security-Policy (next.config.ts). Unset = Report-Only: nothing is
# blocked, violations are logged as "[CSP violation]". Set to "true" to enforce.
# CSP_ENFORCE="true"

# Binance (Pay with Binance — matches incoming USDT deposits / Pay transfers to invoices).
# Key needs read permission; signed /sapi calls fail with 451 from geo-blocked regions.
BINANCE_API_KEY="your-binance-api-key-here"
BINANCE_API_SECRET="your-binance-api-secret-here"
# BINANCE_API_URL="https://api.binance.com"
# Company Binance USDT deposit addresses shown as QR codes on "Pay with Binance".
BINANCE_USDT_TRC20_ADDRESS=""
BINANCE_USDT_ERC20_ADDRESS=""
# Optional: AccountingEntity / AccountingBank / AccountingCurrency ids to tag
# Binance invoice payments (CostPayment) with.
# BINANCE_PAYMENT_ENTITY_ID=""
# BINANCE_PAYMENT_BANK_ID=""
# BINANCE_PAYMENT_CURRENCY_ID=""

# Cloudflare R2 (S3-compatible) storage for accounting PDFs: vendor invoice
# and payment receipt uploads (src/lib/storage/r2.ts). Private bucket; the
# browser uploads with a short-lived presigned PUT and downloads go through
# admin-only routes. S3_API_ENDPOINT is the account endpoint WITHOUT the bucket
# path, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com. The bucket's CORS
# rule must allow PUT/GET from every origin that uploads (prod + localhost).
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
BUCKET_NAME=
