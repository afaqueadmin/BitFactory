# Environment variables template for BitFactory project
# Copy this file to .env and fill in your actual values

# Database Configuration
# For development, you can use the shared Neon database or create your own
DATABASE_URL="postgresql://your_username:your_password@your_host:5432/your_database?sslmode=require"

# Example with Neon (replace with your actual credentials):
# DATABASE_URL="postgresql://neondb_owner:your_password@your_neon_host.neon.tech/neondb?sslmode=require&channel_binding=require"

# Next.js Configuration (optional)
# NEXTAUTH_SECRET="your_secret_here"
# NEXTAUTH_URL="http://localhost:3000"

# Add these to your existing .env file

# Email Configuration
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_FROM=noreply@bitfactory.com
SMTP_USER=your-email@gmail.com
SMTP_SECURE=false
SMTP_PASSWORD=your-app-specific-password
EMAIL_SERVICE="your-email-service-provider-here" # e.g., "gmail", "mailgun", "smtp"


# Support and Invoices Email Configuration
CC_SUPPORT_EMAIL="you support email here"
CC_INVOICES_EMAIL="your invoices email here"


# Next.js public environment variables (accessible in the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CONFIRMO Configuration
CONFIRMO_WEBHOOK_SECRET="your-confirmo-webhook-secret-here"
CONFIRMO_API_KEY="your-confirmo-api-key-here"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name-here"
CLOUDINARY_API_KEY="your-cloudinary-api-key-here"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-here"

# Luxor Mining Pool API (used by hashprice/payback-history endpoints)
LUXOR_API_KEY="your-luxor-api-key-here"
LUXOR_FIXED_SITE_ID="your-luxor-fixed-site-id-here"

# Cron Job Secret (used for securing cron job endpoints)
CRON_SECRET="your-cron-secret-here"

# JWT Secret (used for signing and verifying JSON Web Tokens)
JWT_SECRET="21d1802566da19a7b22049ef6374dae8235d352dc67958a64df0892505899ded41c4f13c3fff691370e00d4a5011b8855603a6127eb9ddfe33f6fd23cad314ab"
JWT_ACCESS_TOKEN_SECRET="your-jwt-access-token-secret-here"
JWT_REFRESH_TOKEN_SECRET="your-jwt-refresh-token-secret-here"

# Two-Factor Authentication Configuration
TWO_FACTOR_ENABLED="true" # Set to "true" to enable two-factor authentication, "false" to disable